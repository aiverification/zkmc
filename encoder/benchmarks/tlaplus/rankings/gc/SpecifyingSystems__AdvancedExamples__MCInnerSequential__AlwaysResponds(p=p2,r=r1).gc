trans(q2, q1): act == 1 && regFile_p2_r1_op <= 1
trans(q2, q2): act == 0 && regFile_p2_r1_op <= 1

rank(q0):
  [] ((2 * act) + (-1 * regFile_p2_r1_op)) <= 0 -> 0
  [] ((2 * act) + (-1 * regFile_p2_r1_op)) > 0 -> inf

rank(q1):
  [] true -> inf

rank(q2):
