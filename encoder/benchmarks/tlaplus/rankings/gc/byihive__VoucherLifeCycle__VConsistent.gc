init: vState_v1 == 0 && vState_v2 == 0 && vState_v3 == 0 && vlcState_v1 == 0 && vlcState_v2 == 0 && vlcState_v3 == 0

// VNext
[] vState_v1 == 0 && vlcState_v1 == 0 -> vState_v1 = 1; vlcState_v1 = 1
// VNext
[] vState_v1 == 1 && vlcState_v1 == 1 -> vState_v1 = 2; vlcState_v1 = 2
