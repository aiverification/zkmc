rank(q1):
  [] ((2 * vState_v1) + (-3 * vlcState_v1)) <= 0 && ((-1 * vState_v1) + vlcState_v1) <= 0 && ((2 * vState_v2) + (-3 * vlcState_v2)) <= 0 && ((-1 * vState_v2) + vlcState_v2) <= 0 && ((2 * vState_v3) + (-3 * vlcState_v3)) <= 0 && ((-1 * vState_v3) + vlcState_v3) <= 0 -> 0
