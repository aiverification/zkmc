[] vState_v3 == 1 && vlcState_v3 == 1 -> vState_v3 = 2; vlcState_v3 = 2
// VNext
[] vState_v3 == 1 && vlcState_v3 == 1 -> vState_v3 = 3; vlcState_v3 = 2
// stuttering
[] true -> vState_v1 = vState_v1

