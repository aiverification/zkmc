// TLA+ model SpecifyingSystems__Liveness__LiveHourClock
// 1 variables, 1 slots, 12 commands, 12 initial states
//   hr: hr

type hr: 1..12
type act: 0..1

init: hr >= 1 && hr <= 12 && act == 0

// HCnxt
[] hr == 1 -> act = 1; hr = 2
// HCnxt
[] hr == 2 -> act = 1; hr = 3
// HCnxt
[] hr == 3 -> act = 1; hr = 4
// HCnxt
[] hr == 4 -> act = 1; hr = 5
// HCnxt
[] hr == 5 -> act = 1; hr = 6
// HCnxt
[] hr == 6 -> act = 1; hr = 7
// HCnxt
[] hr == 7 -> act = 1; hr = 8
// HCnxt
[] hr == 8 -> act = 1; hr = 9
// HCnxt
[] hr == 9 -> act = 1; hr = 10
// HCnxt
[] hr == 10 -> act = 1; hr = 11
// HCnxt
[] hr == 11 -> act = 1; hr = 12
// HCnxt
[] hr == 12 -> act = 1; hr = 1
// stuttering
[] true -> act = 0

// AllTimes[n=12]: property AllTimes[n=12] under 1 of the 1 fairness conditions
// LTL: !(((G(F(false)) | G(F(p1))) & F(G(p0))))
//   p0 := (hr <= 11)
//   p1 := (act == 1)
// Büchi automaton of the negated property (Spot ltl2tgba -B)
automaton_init: q0
trans(q0, q0): true
trans(q0, q1): act == 1 && hr <= 11
trans!(q1, q1): act == 1 && hr <= 11
trans!(q1, q2): act == 0 && hr <= 11
trans(q2, q1): act == 1 && hr <= 11
trans(q2, q2): act == 0 && hr <= 11

rank(q0):
  [] true -> 11

rank(q1):
  [] ((-1 * act) + hr) <= 11 -> ((12 + act) + (-1 * hr))
  [] ((-1 * act) + hr) > 11 -> inf

rank(q2):
  [] ((-1 * act) + hr) <= 11 -> ((11 + act) + (-1 * hr))
  [] ((-1 * act) + hr) > 11 -> inf
