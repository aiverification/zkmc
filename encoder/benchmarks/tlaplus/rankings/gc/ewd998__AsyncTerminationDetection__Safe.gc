// Safe: invariant Safe
// LTL: G(p0)
//   p0 := (terminationDetected == 0) || (active_0 == 0 && active_1 == 0 && active_2 == 0 && active_3 == 0 && pending_0 == 0 && pending_1 == 0 && pending_2 == 0 && pending_3 == 0)
// Büchi automaton of the negated property (Spot ltl2tgba -B)
automaton_init: q1
trans!(q0, q0): true
trans(q1, q0): active_0 == 1 && terminationDetected == 1
trans(q1, q0): pending_0 >= 1 && terminationDetected == 1
trans(q1, q0): active_1 == 1 && terminationDetected == 1
trans(q1, q0): pending_1 >= 1 && terminationDetected == 1
trans(q1, q0): active_2 == 1 && terminationDetected == 1
trans(q1, q0): pending_2 >= 1 && terminationDetected == 1
trans(q1, q0): active_3 == 1 && terminationDetected == 1
trans(q1, q0): pending_3 >= 1 && terminationDetected == 1
trans(q1, q1): terminationDetected == 0
trans(q1, q1): active_0 == 0 && active_1 == 0 && active_2 == 0 && active_3 == 0 && pending_0 == 0 && pending_1 == 0 && pending_2 == 0 && pending_3 == 0

rank(q1):
  [] (active_0 + terminationDetected) <= 1 && (active_1 + terminationDetected) <= 1 && (active_2 + terminationDetected) <= 1 && (active_3 + terminationDetected) <= 1 && (pending_0 + (3 * terminationDetected)) <= 3 && (pending_1 + (3 * terminationDetected)) <= 3 && (pending_2 + (3 * terminationDetected)) <= 3 && (pending_3 + (3 * terminationDetected)) <= 3 -> 0
  [] (active_0 + terminationDetected) > 1 -> inf
  [] (active_0 + terminationDetected) <= 1 && (active_1 + terminationDetected) > 1 -> inf
  [] (active_0 + terminationDetected) <= 1 && (active_1 + terminationDetected) <= 1 && (active_2 + terminationDetected) > 1 -> inf
  [] (active_0 + terminationDetected) <= 1 && (active_1 + terminationDetected) <= 1 && (active_2 + terminationDetected) <= 1 && (active_3 + terminationDetected) > 1 -> inf
  [] (active_0 + terminationDetected) <= 1 && (active_1 + terminationDetected) <= 1 && (active_2 + terminationDetected) <= 1 && (active_3 + terminationDetected) <= 1 && (pending_0 + (3 * terminationDetected)) > 3 -> inf
  [] (active_0 + terminationDetected) <= 1 && (active_1 + terminationDetected) <= 1 && (active_2 + terminationDetected) <= 1 && (active_3 + terminationDetected) <= 1 && (pending_0 + (3 * terminationDetected)) <= 3 && (pending_1 + (3 * terminationDetected)) > 3 -> inf
  [] (active_0 + terminationDetected) <= 1 && (active_1 + terminationDetected) <= 1 && (active_2 + terminationDetected) <= 1 && (active_3 + terminationDetected) <= 1 && (pending_0 + (3 * terminationDetected)) <= 3 && (pending_1 + (3 * terminationDetected)) <= 3 && (pending_2 + (3 * terminationDetected)) > 3 -> inf
  [] (active_0 + terminationDetected) <= 1 && (active_1 + terminationDetected) <= 1 && (active_2 + terminationDetected) <= 1 && (active_3 + terminationDetected) <= 1 && (pending_0 + (3 * terminationDetected)) <= 3 && (pending_1 + (3 * terminationDetected)) <= 3 && (pending_2 + (3 * terminationDetected)) <= 3 && (pending_3 + (3 * terminationDetected)) > 3 -> inf

rank(q0):
