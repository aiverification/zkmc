//   p3 := (act == 1)
// Büchi automaton of the negated property (Spot ltl2tgba -B)
automaton_init: q0
trans(q0, q0): true
trans(q0, q1): alloc_c2_r2 == 1 && unsat_c2_r1 == 0 && unsat_c2_r2 == 0
trans(q0, q1): alloc_c2_r1 == 1 && unsat_c2_r1 == 0 && unsat_c2_r2 == 0
