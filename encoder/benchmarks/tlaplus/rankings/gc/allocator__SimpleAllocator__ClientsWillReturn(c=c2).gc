trans(q2, q2): act == 0 && alloc_c2_r2 == 1
trans(q2, q2): act == 0 && alloc_c2_r1 == 1 && alloc_c2_r2 == 0

rank(q0):
  [] true -> 1

rank(q1):
  [] unsat_c2_r1 = 0 && unsat_c2_r2 = 0 && (act + alloc_c2_r1) <= 1 && (act + alloc_c2_r2) <= 1 -> 1
  [] unsat_c2_r1 < 0 -> inf
  [] unsat_c2_r1 > 0 -> inf
  [] unsat_c2_r1 = 0 && unsat_c2_r2 < 0 -> inf
  [] unsat_c2_r1 = 0 && unsat_c2_r2 > 0 -> inf
  [] unsat_c2_r1 = 0 && unsat_c2_r2 = 0 && (act + alloc_c2_r1) > 1 -> inf
  [] unsat_c2_r1 = 0 && unsat_c2_r2 = 0 && (act + alloc_c2_r1) <= 1 && (act + alloc_c2_r2) > 1 -> inf

