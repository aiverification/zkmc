// TLA+ model byzpaxos__Consensus
// 1 variables, 3 slots, 3 commands, 1 initial states
//   chosen: chosen_v1 chosen_v2 chosen_v3
//   chosen_v1: v1 in set
//   chosen_v2: v2 in set
//   chosen_v3: v3 in set

type chosen_v1: 0..1
type chosen_v2: 0..1
type chosen_v3: 0..1

init: chosen_v1 == 0 && chosen_v2 == 0 && chosen_v3 == 0

// 
[] chosen_v1 == 0 && chosen_v2 == 0 && chosen_v3 == 0 -> chosen_v1 = 1
// 
[] chosen_v1 == 0 && chosen_v2 == 0 && chosen_v3 == 0 -> chosen_v2 = 1
// 
[] chosen_v1 == 0 && chosen_v2 == 0 && chosen_v3 == 0 -> chosen_v3 = 1
// stuttering
[] true -> chosen_v1 = chosen_v1

// Inv: invariant Inv
// LTL: G(p0)
//   p0 := (chosen_v1 + chosen_v2 + chosen_v3 <= 1)
// Büchi automaton of the negated property (Spot ltl2tgba -B)
automaton_init: q1
trans!(q0, q0): true
trans(q1, q0): chosen_v1 + chosen_v2 + chosen_v3 - 2 >= 0
trans(q1, q1): chosen_v1 + chosen_v2 + chosen_v3 <= 1

rank(q1):
  [] (((chosen_v1 + chosen_v2) + chosen_v3) - 2) < 0 -> 0
  [] (((chosen_v1 + chosen_v2) + chosen_v3) - 2) >= 0 -> inf

rank(q0):
  [] true -> inf
