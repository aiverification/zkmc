// INext
[] ctl_p1 == 2 -> act = 1; ctl_p1 = 0; memInt_1 = 0; memInt_2 = buf_p1
// INext
[] ctl_p2 == 0 -> act = 0; ctl_p2 = 1; buf_p2 = 3; memInt_1 = 1; memInt_2 = 3
