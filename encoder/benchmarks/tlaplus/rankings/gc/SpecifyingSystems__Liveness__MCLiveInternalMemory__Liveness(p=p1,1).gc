[] buf_p2 == 11 && ctl_p2 == 1 -> act = 0; mem_a3 = 1; ctl_p2 = 2; buf_p2 = 2
// INext
[] buf_p2 == 3 && ctl_p2 == 1 && mem_a1 == 0 -> act = 0; ctl_p2 = 2; buf_p2 = 0
