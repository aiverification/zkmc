[] buf_p2 == 5 && ctl_p2 == 1 && mem_a3 == 1 -> act = 0; ctl_p2 = 2; buf_p2 = 1
// INext
[] ctl_p2 == 2 -> act = 0; ctl_p2 = 0; memInt_1 = 1; memInt_2 = buf_p2
// stuttering
[] true -> act = 0

// Liveness[p=p1,1]: property Liveness[p=p1,1] under 1 of the 2 fairness conditions
// LTL: !(((G(F(p0)) | G(F(p1))) & (F(G(p4)) & F(G(p3)))))
//   p0 := (ctl_p1 == 0)
//   p1 := (act >= 1)
//   p2 := (act == 2)
//   p3 := (act <= 1)
//   p4 := (ctl_p1 == 1)
//   p5 := (ctl_p1 == 0) || (ctl_p1 == 2)
// Büchi automaton of the negated property (Spot ltl2tgba -B)
automaton_init: q0
trans(q0, q0): true
trans(q0, q1): act == 1 && ctl_p1 == 1
trans!(q1, q1): act == 1 && ctl_p1 == 1
trans!(q1, q2): act == 0 && ctl_p1 == 1
trans(q2, q1): act == 1 && ctl_p1 == 1
trans(q2, q2): act == 0 && ctl_p1 == 1

rank(q0):
  [] ((9 * act) + (2 * buf_p1)) <= 22 && (buf_p1 + (9 * ctl_p1)) <= 20 -> 12
  [] ((9 * act) + (2 * buf_p1)) > 22 -> inf
  [] ((9 * act) + (2 * buf_p1)) <= 22 && (buf_p1 + (9 * ctl_p1)) > 20 -> inf

rank(q1):
  [] act >= 0 && buf_p1 >= 0 -> ((1 + act) + buf_p1)
  [] act < 0 -> inf
  [] act >= 0 && buf_p1 < 0 -> inf

rank(q2):
  [] act >= 0 && buf_p1 >= 0 -> ((0 + act) + buf_p1)
  [] act < 0 -> inf
  [] act >= 0 && buf_p1 < 0 -> inf
