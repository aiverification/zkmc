// TLA+ model SpecifyingSystems__Liveness__MCLiveInternalMemory
// 4 variables, 9 slots, 44 commands, 8 initial states
//   mem: mem_a1 mem_a2 mem_a3
//   ctl: ctl_p1 ctl_p2
//   buf: buf_p1 buf_p2
//   memInt: memInt_1 memInt_2
//   mem_a1: 0=v1, 1=v2
//   mem_a2: 0=v1, 1=v2
//   mem_a3: 0=v1, 1=v2
//   ctl_p1: 0="rdy", 1="busy", 2="done"
//   ctl_p2: 0="rdy", 1="busy", 2="done"
//   buf_p1: 0=v1, 1=v2, 2=NoVal, 3=[adr |-> a1, op |-> "Rd"], 4=[adr |-> a2, op |-> "Rd"], 5=[adr |-> a3, op |-> "Rd"], 6=[adr |-> a1, op |-> "Wr", val |-> v1], 7=[adr |-> a2, op |-> "Wr", val |-> v1], 8=[adr |-> a3, op |-> "Wr", val |-> v1], 9=[adr |-> a1, op |-> "Wr", val |-> v2], 10=[adr |-> a2, op |-> "Wr", val |-> v2], 11=[adr |-> a3, op |-> "Wr", val |-> v2]
//   buf_p2: 0=v1, 1=v2, 2=NoVal, 3=[adr |-> a1, op |-> "Rd"], 4=[adr |-> a2, op |-> "Rd"], 5=[adr |-> a3, op |-> "Rd"], 6=[adr |-> a1, op |-> "Wr", val |-> v1], 7=[adr |-> a2, op |-> "Wr", val |-> v1], 8=[adr |-> a3, op |-> "Wr", val |-> v1], 9=[adr |-> a1, op |-> "Wr", val |-> v2], 10=[adr |-> a2, op |-> "Wr", val |-> v2], 11=[adr |-> a3, op |-> "Wr", val |-> v2]
//   memInt_1: 0=p1, 1=p2
//   memInt_2: 0=v1, 1=v2, 2=NoVal, 3=[adr |-> a1, op |-> "Rd"], 4=[adr |-> a2, op |-> "Rd"], 5=[adr |-> a3, op |-> "Rd"], 6=[adr |-> a1, op |-> "Wr", val |-> v1], 7=[adr |-> a2, op |-> "Wr", val |-> v1], 8=[adr |-> a3, op |-> "Wr", val |-> v1], 9=[adr |-> a1, op |-> "Wr", val |-> v2], 10=[adr |-> a2, op |-> "Wr", val |-> v2], 11=[adr |-> a3, op |-> "Wr", val |-> v2]

type mem_a1: 0..1
type mem_a2: 0..1
type mem_a3: 0..1
type ctl_p1: 0..2
type ctl_p2: 0..2
type buf_p1: 0..11
type buf_p2: 0..11
type memInt_1: 0..1
type memInt_2: 0..11
type act: 0..2

init: mem_a1 >= 0 && mem_a1 <= 1 && mem_a2 >= 0 && mem_a2 <= 1 && mem_a3 >= 0 && mem_a3 <= 1 && ctl_p1 == 0 && ctl_p2 == 0 && buf_p1 == 2 && buf_p2 == 2 && memInt_1 == 0 && memInt_2 == 2 && act == 0

// INext
[] ctl_p1 == 0 -> act = 0; ctl_p1 = 1; buf_p1 = 3; memInt_1 = 0; memInt_2 = 3
// INext
[] ctl_p1 == 0 -> act = 0; ctl_p1 = 1; buf_p1 = 4; memInt_1 = 0; memInt_2 = 4
