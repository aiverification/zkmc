// TLA+ model Prisoners_Single_Switch__PrisonerSolo
// 5 variables, 2 slots, 1 commands, 1 initial states
//   count: (constant)
//   announced: announced
//   signalled: (constant)
//   light: (constant)
//   has_visited: has_visited_Alice
//   has_visited_Alice: "Alice" in set

type announced: 0..1
type has_visited_Alice: 0..1
type act: 0..1

init: announced == 0 && has_visited_Alice == 0 && act == 0

// WardenAction("Alice")
[] announced == 0 -> act = 1; announced = 1; has_visited_Alice = 1
// WardenAction("Alice")
[] has_visited_Alice == 0 -> act = 1; announced = 1; has_visited_Alice = 1
// WardenAction("Alice")
[] announced == 1 && has_visited_Alice == 1 -> act = 0; announced = 1; has_visited_Alice = 1
// stuttering
[] true -> act = 0

// Terminating: property Terminating under 1 of the 1 fairness conditions
// LTL: !(((G(F(p1)) | G(F(p2))) & G(p0)))
//   p0 := (announced == 0)
//   p1 := (announced == 1 && has_visited_Alice == 1)
//   p2 := (act == 1)
// Büchi automaton of the negated property (Spot ltl2tgba -B)
automaton_init: q0
trans!(q0, q0): act == 1 && announced == 0
trans!(q0, q1): act == 0 && announced == 0
trans(q1, q0): act == 1 && announced == 0
trans(q1, q1): act == 0 && announced == 0

rank(q0):
  [] act = 0 -> 1
  [] act < 0 -> inf
  [] act > 0 -> inf

rank(q1):
  [] ((-1 * act) + announced) = 0 -> 0
  [] ((-1 * act) + announced) < 0 -> inf
  [] ((-1 * act) + announced) > 0 -> inf
