// MCC instance TwoPhaseLocking-PT-nC00100vD
// 8 places, 6 transitions
// places: p0=resB, p1=haveA, p2=haveA2, p3=resA, p4=haveB, p5=Clients, p6=haveAandB, p7=haveA2andB

init: p0 == 50 && p1 == 0 && p2 == 0 && p3 == 50 && p4 == 0 && p5 == 100 && p6 == 0 && p7 == 0

// relB
[] p7 >= 1 -> p0 = p0 + 1; p2 = p2 + 1; p7 = p7 - 1
// lockB
[] p1 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 - 1; p6 = p6 + 1
// lockA
[] p5 >= 1 && p3 >= 1 -> p1 = p1 + 1; p3 = p3 - 1; p5 = p5 - 1
// relA2
[] p2 >= 1 -> p2 = p2 - 1; p3 = p3 + 1; p5 = p5 + 1
// relA
[] p6 >= 1 -> p3 = p3 + 1; p4 = p4 + 1; p6 = p6 - 1
// lockA2
[] p4 >= 1 && p3 >= 1 -> p3 = p3 - 1; p4 = p4 - 1; p7 = p7 + 1
// deadlock: stutter (MCC semantics)
[] p0 <= 0 && p2 <= 0 && p3 <= 0 && p6 <= 0 && p7 <= 0 -> p0 = p0

// TwoPhaseLocking-PT-nC00100vD-LTLFireability-00
// ap e0 := p6 >= 1
// ap e1 := p5 >= 1 && p3 >= 1
// ap e2 := p2 >= 1
// spec: "((X(X(X((F(!((e0))) & X((e0))))))) U (((e1) | (e2))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans(q0, q1): p5 < 1 && p2 < 1
trans(q0, q1): p3 < 1 && p2 < 1
trans!(q1, q1): p5 < 1 && p2 < 1
trans!(q1, q1): p3 < 1 && p2 < 1
trans!(q1, q2): true
trans(q2, q3): true
trans(q3, q4): true
trans(q3, q5): p6 >= 1
trans(q4, q6): p6 < 1
trans!(q5, q5): p6 >= 1
trans!(q6, q6): true

rank(q0):
  [] p0 = 50 && p1 = 0 && p3 = 50 && p4 = 0 && p5 = 100 -> 0
  [] p0 < 50 -> inf
  [] p0 > 50 -> inf
  [] p0 = 50 && p1 < 0 -> inf
  [] p0 = 50 && p1 > 0 -> inf
  [] p0 = 50 && p1 = 0 && p3 < 50 -> inf
  [] p0 = 50 && p1 = 0 && p3 > 50 -> inf
  [] p0 = 50 && p1 = 0 && p3 = 50 && p4 < 0 -> inf
  [] p0 = 50 && p1 = 0 && p3 = 50 && p4 > 0 -> inf
  [] p0 = 50 && p1 = 0 && p3 = 50 && p4 = 0 && p5 < 100 -> inf
  [] p0 = 50 && p1 = 0 && p3 = 50 && p4 = 0 && p5 > 100 -> inf

rank(q1):
  [] true -> inf

rank(q2):
  [] true -> inf

rank(q3):
  [] true -> inf

rank(q4):
  [] true -> inf

rank(q5):
  [] true -> inf

rank(q6):
  [] true -> inf
