// MCC instance Murphy-PT-D1N010
// 12 places, 14 transitions
// places: p0=p0_1, p1=p0_2, p2=p1_1, p3=p1_2, p4=p2_1, p5=p2_2, p6=p3_1, p7=p3_2, p8=p4_1, p9=p4_2, p10=p5_1, p11=p5_2

init: p0 == 1 && p1 == 1 && p2 == 10 && p3 == 10 && p4 == 1 && p5 == 1 && p6 == 0 && p7 == 0 && p8 == 0 && p9 == 0 && p10 == 3 && p11 == 3

// t0
[] p0 >= 1 && p2 >= 1 -> p0 = p0 + 1; p2 = p2 - 1; p4 = p4 + 1
// t1
[] p1 >= 1 && p3 >= 1 -> p1 = p1 + 1; p3 = p3 - 1; p5 = p5 + 1
// t2
[] p0 >= 3 && p4 >= 1 && p8 >= 1 -> p0 = p0 - 1; p2 = p2 + 1; p4 = p4 - 1
// t3
[] p1 >= 3 && p5 >= 1 && p9 >= 1 -> p1 = p1 - 1; p3 = p3 + 1; p5 = p5 - 1
// t4
[] p0 >= 1 && p2 >= 1 && p4 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p2 = p2 - 1; p3 = p3 + 1; p4 = p4 - 1; p5 = p5 + 1
// t5
[] p1 >= 1 && p3 >= 1 && p5 >= 1 -> p0 = p0 + 1; p1 = p1 - 1; p2 = p2 + 1; p3 = p3 - 1; p4 = p4 + 1; p5 = p5 - 1
// t6
[] p6 >= 2 && p8 >= 1 -> p6 = p6 + 1; p8 = p8 + 1
// t7
[] p7 >= 2 && p9 >= 1 -> p7 = p7 + 1; p9 = p9 + 1
// t8
[] p6 >= 1 -> p6 = p6 - 1; p10 = p10 + 1
// t9
[] p7 >= 1 -> p7 = p7 - 1; p11 = p11 + 1
// t10
[] p10 >= 3 -> p6 = p6 + 1; p8 = p8 + 2; p10 = p10 - 3
// t11
[] p11 >= 3 -> p7 = p7 + 1; p9 = p9 + 2; p11 = p11 - 3
// t12
[] p8 >= 1 -> p8 = p8 - 1; p10 = p10 + 1
// t13
[] p9 >= 1 -> p9 = p9 - 1; p11 = p11 + 1

// Murphy-PT-D1N010-LTLFireability-11
// ap e0 := p1 >= 1 && p3 >= 1
// ap e1 := p7 >= 2 && p9 >= 1
// spec: "F(G(!(G((((e0)) U ((e1)))))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans(q0, q0): true
trans(q0, q1): p7 >= 2 && p9 >= 1
trans!(q1, q1): p7 >= 2 && p9 >= 1
trans!(q1, q2): p1 >= 1 && p3 >= 1 && p7 < 2
trans!(q1, q2): p1 >= 1 && p3 >= 1 && p9 < 1
trans(q2, q1): p7 >= 2 && p9 >= 1
trans(q2, q2): p1 >= 1 && p3 >= 1 && p7 < 2
trans(q2, q2): p1 >= 1 && p3 >= 1 && p9 < 1

rank(q0):
  [] p6 <= 1 && p7 <= 1 && p8 >= 0 && p9 >= 0 && ((p10 + p6) + p8) = 3 && ((p11 + p7) + p9) = 3 -> 0
  [] p6 > 1 -> inf
  [] p6 <= 1 && p7 > 1 -> inf
  [] p6 <= 1 && p7 <= 1 && p8 < 0 -> inf
  [] p6 <= 1 && p7 <= 1 && p8 >= 0 && p9 < 0 -> inf
  [] p6 <= 1 && p7 <= 1 && p8 >= 0 && p9 >= 0 && ((p10 + p6) + p8) < 3 -> inf
  [] p6 <= 1 && p7 <= 1 && p8 >= 0 && p9 >= 0 && ((p10 + p6) + p8) > 3 -> inf
  [] p6 <= 1 && p7 <= 1 && p8 >= 0 && p9 >= 0 && ((p10 + p6) + p8) = 3 && ((p11 + p7) + p9) < 3 -> inf
  [] p6 <= 1 && p7 <= 1 && p8 >= 0 && p9 >= 0 && ((p10 + p6) + p8) = 3 && ((p11 + p7) + p9) > 3 -> inf

rank(q1):
  [] true -> inf

rank(q2):
  [] true -> inf
