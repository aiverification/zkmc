automaton_init: q1
trans!(q0, q0): true
trans(q1, q0): p0 < 1
trans(q1, q0): p3 < 1

rank(q1):
  [] p0 = 1 && p1 = 1 && p2 = 1 && p3 = 5 -> 0
  [] p0 < 1 -> inf
