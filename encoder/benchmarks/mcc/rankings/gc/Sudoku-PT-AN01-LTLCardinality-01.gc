// MCC instance Sudoku-PT-AN01
// 4 places, 1 transitions
// places: p0=Rows_0_0, p1=Board_0_0_0, p2=Cells_0_0, p3=Columns_0_0

init: p0 == 1 && p1 == 0 && p2 == 1 && p3 == 1

// select_0_0_0
[] p2 >= 1 && p3 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p2 = p2 - 1; p3 = p3 - 1
// deadlock: stutter (MCC semantics)
[] p3 <= 0 -> p0 = p0

// Sudoku-PT-AN01-LTLCardinality-01
// ap a0 := 3 <= p3
// ap a1 := p1 <= p0
// spec: "G(F(((a0) U (X(!((a0 | a1)))))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans(q0, q0): true
trans(q0, q1): 3 <= p3
trans(q0, q1): p1 <= p0
trans!(q1, q1): 3 <= p3
trans!(q1, q1): p1 <= p0

rank(q0):
  [] (p0 + p1) = 1 && ((-1 * p0) + p3) = 0 && p3 <= 1 -> 0
  [] (p0 + p1) < 1 -> inf
  [] (p0 + p1) > 1 -> inf
  [] (p0 + p1) = 1 && ((-1 * p0) + p3) < 0 -> inf
  [] (p0 + p1) = 1 && ((-1 * p0) + p3) > 0 -> inf
  [] (p0 + p1) = 1 && ((-1 * p0) + p3) = 0 && p3 > 1 -> inf

rank(q1):
  [] p0 = 0 && p1 = 1 -> 0
  [] p0 < 0 -> inf
  [] p0 > 0 -> inf
  [] p0 = 0 && p1 < 1 -> inf
  [] p0 = 0 && p1 > 1 -> inf
