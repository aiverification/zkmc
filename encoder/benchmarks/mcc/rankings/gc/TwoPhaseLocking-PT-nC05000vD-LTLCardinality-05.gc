// MCC instance TwoPhaseLocking-PT-nC05000vD
// 8 places, 6 transitions
// places: p0=resB, p1=haveA, p2=haveA2, p3=resA, p4=haveB, p5=Clients, p6=haveAandB, p7=haveA2andB

init: p0 == 2500 && p1 == 0 && p2 == 0 && p3 == 2500 && p4 == 0 && p5 == 5000 && p6 == 0 && p7 == 0

// relB
[] p7 >= 1 -> p0 = p0 + 1; p2 = p2 + 1; p7 = p7 - 1
// lockB
[] p1 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 - 1; p6 = p6 + 1
// lockA
[] p5 >= 1 && p3 >= 1 -> p1 = p1 + 1; p3 = p3 - 1; p5 = p5 - 1
// relA2
[] p2 >= 1 -> p2 = p2 - 1; p3 = p3 + 1; p5 = p5 + 1
// relA
[] p6 >= 1 -> p3 = p3 + 1; p4 = p4 + 1; p6 = p6 - 1
// lockA2
[] p4 >= 1 && p3 >= 1 -> p3 = p3 - 1; p4 = p4 - 1; p7 = p7 + 1
// deadlock: stutter (MCC semantics)
[] p0 <= 0 && p2 <= 0 && p3 <= 0 && p6 <= 0 && p7 <= 0 -> p0 = p0

// TwoPhaseLocking-PT-nC05000vD-LTLCardinality-05
// ap a0 := p2 <= p5
// ap a1 := p3 <= p4
// ap a2 := 2 <= p6
// spec: "(X(a0) | G((a1 | a2)) | X((a0 | F(a0))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q1
trans!(q0, q0): p2 > p5
trans(q1, q0): p3 > p4 && 2 > p6
trans(q1, q2): p3 <= p4
trans(q1, q2): 2 <= p6
trans(q2, q0): p3 > p4 && p2 > p5 && 2 > p6
trans(q2, q2): p3 <= p4 && p2 > p5
trans(q2, q2): p2 > p5 && 2 <= p6

rank(q1):
  [] p5 = 5000 && p0 = 2500 && p2 = 0 && p4 = 0 && (p1 + p5) = 5000 && p6 = 0 && p7 = 0 -> 0
  [] p5 < 5000 -> inf
  [] p5 > 5000 -> inf
  [] p5 = 5000 && p0 < 2500 -> inf
  [] p5 = 5000 && p0 > 2500 -> inf
  [] p5 = 5000 && p0 = 2500 && p2 < 0 -> inf
  [] p5 = 5000 && p0 = 2500 && p2 > 0 -> inf
  [] p5 = 5000 && p0 = 2500 && p2 = 0 && p4 < 0 -> inf
  [] p5 = 5000 && p0 = 2500 && p2 = 0 && p4 > 0 -> inf
  [] p5 = 5000 && p0 = 2500 && p2 = 0 && p4 = 0 && (p1 + p5) < 5000 -> inf
  [] p5 = 5000 && p0 = 2500 && p2 = 0 && p4 = 0 && (p1 + p5) > 5000 -> inf
  [] p5 = 5000 && p0 = 2500 && p2 = 0 && p4 = 0 && (p1 + p5) = 5000 && p6 < 0 -> inf
  [] p5 = 5000 && p0 = 2500 && p2 = 0 && p4 = 0 && (p1 + p5) = 5000 && p6 > 0 -> inf
  [] p5 = 5000 && p0 = 2500 && p2 = 0 && p4 = 0 && (p1 + p5) = 5000 && p6 = 0 && p7 < 0 -> inf
  [] p5 = 5000 && p0 = 2500 && p2 = 0 && p4 = 0 && (p1 + p5) = 5000 && p6 = 0 && p7 > 0 -> inf

rank(q0):
  [] p5 = 4999 && p0 = 2500 && p2 = 0 && p4 = 0 && p6 = 0 && p7 = 0 -> 0
  [] p5 < 4999 -> inf
  [] p5 > 4999 -> inf
  [] p5 = 4999 && p0 < 2500 -> inf
  [] p5 = 4999 && p0 > 2500 -> inf
  [] p5 = 4999 && p0 = 2500 && p2 < 0 -> inf
  [] p5 = 4999 && p0 = 2500 && p2 > 0 -> inf
  [] p5 = 4999 && p0 = 2500 && p2 = 0 && p4 < 0 -> inf
  [] p5 = 4999 && p0 = 2500 && p2 = 0 && p4 > 0 -> inf
  [] p5 = 4999 && p0 = 2500 && p2 = 0 && p4 = 0 && p6 < 0 -> inf
  [] p5 = 4999 && p0 = 2500 && p2 = 0 && p4 = 0 && p6 > 0 -> inf
  [] p5 = 4999 && p0 = 2500 && p2 = 0 && p4 = 0 && p6 = 0 && p7 < 0 -> inf
  [] p5 = 4999 && p0 = 2500 && p2 = 0 && p4 = 0 && p6 = 0 && p7 > 0 -> inf

rank(q2):
  [] true -> inf
