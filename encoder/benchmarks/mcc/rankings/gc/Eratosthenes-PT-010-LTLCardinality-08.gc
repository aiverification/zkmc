// MCC instance Eratosthenes-PT-010
// 9 places, 8 transitions
// places: p0=p2, p1=p3, p2=p6, p3=p7, p4=p4, p5=p5, p6=p8, p7=p9, p8=p10

init: p0 == 1 && p1 == 1 && p2 == 1 && p3 == 1 && p4 == 1 && p5 == 1 && p6 == 1 && p7 == 1 && p8 == 1

// t10_2
[] p8 >= 1 && p0 >= 1 -> p8 = p8 - 1
// t6_2
[] p0 >= 1 && p2 >= 1 -> p2 = p2 - 1
// t6_3
[] p1 >= 1 && p2 >= 1 -> p2 = p2 - 1
// t8_2
[] p0 >= 1 && p6 >= 1 -> p6 = p6 - 1
// t10_5
[] p8 >= 1 && p5 >= 1 -> p8 = p8 - 1
// t9_3
[] p1 >= 1 && p7 >= 1 -> p7 = p7 - 1
// t8_4
[] p4 >= 1 && p6 >= 1 -> p6 = p6 - 1
// t4_2
[] p0 >= 1 && p4 >= 1 -> p4 = p4 - 1
// deadlock: stutter (MCC semantics)
[] p2 <= 0 && p4 <= 0 && p6 <= 0 && p7 <= 0 && p8 <= 0 -> p0 = p0

// Eratosthenes-PT-010-LTLCardinality-08
// ap a0 := p6 <= p2
// ap a1 := 2 <= p7
// ap a2 := p7 <= p1
// spec: "(((a0) U (F(X(a0)))) & (!(a1) | !(G(!(a2)))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans(q0, q1): 2 <= p7 && p7 > p1
trans(q0, q2): true
trans!(q1, q1): p7 > p1
trans!(q2, q2): p6 > p2

rank(q0):
  [] p2 = 1 && p4 = 1 && p6 = 1 && p7 = 1 && p8 = 1 -> (3 + p6)
  [] p2 < 1 -> inf
  [] p2 > 1 -> inf
  [] p2 = 1 && p4 < 1 -> inf
  [] p2 = 1 && p4 > 1 -> inf
  [] p2 = 1 && p4 = 1 && p6 < 1 -> inf
  [] p2 = 1 && p4 = 1 && p6 > 1 -> inf
  [] p2 = 1 && p4 = 1 && p6 = 1 && p7 < 1 -> inf
  [] p2 = 1 && p4 = 1 && p6 = 1 && p7 > 1 -> inf
  [] p2 = 1 && p4 = 1 && p6 = 1 && p7 = 1 && p8 < 1 -> inf
  [] p2 = 1 && p4 = 1 && p6 = 1 && p7 = 1 && p8 > 1 -> inf

rank(q1):
  [] true -> inf

rank(q2):
  [] p2 >= 0 && p4 >= 0 && p6 >= 0 && p6 <= 1 && p7 >= 0 && p8 >= 0 && p8 <= 1 -> ((((0 + p4) + p6) + p7) + p8)
  [] p2 < 0 -> inf
  [] p2 >= 0 && p4 < 0 -> inf
  [] p2 >= 0 && p4 >= 0 && p6 < 0 -> inf
  [] p2 >= 0 && p4 >= 0 && p6 >= 0 && p6 > 1 -> inf
  [] p2 >= 0 && p4 >= 0 && p6 >= 0 && p6 <= 1 && p7 < 0 -> inf
  [] p2 >= 0 && p4 >= 0 && p6 >= 0 && p6 <= 1 && p7 >= 0 && p8 < 0 -> inf
  [] p2 >= 0 && p4 >= 0 && p6 >= 0 && p6 <= 1 && p7 >= 0 && p8 >= 0 && p8 > 1 -> inf
