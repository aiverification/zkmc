// MCC instance SwimmingPool-PT-09
// 9 places, 7 transitions
// places: p0=Entered, p1=WaitBag, p2=Undress, p3=InBath, p4=Dress, p5=Dressed, p6=Out, p7=Cabins, p8=Bags

init: p0 == 0 && p1 == 0 && p2 == 0 && p3 == 0 && p4 == 0 && p5 == 0 && p6 == 180 && p7 == 90 && p8 == 135

// GetK
[] p7 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p7 = p7 - 1
// GetB
[] p8 >= 1 && p1 >= 1 -> p1 = p1 - 1; p2 = p2 + 1; p8 = p8 - 1
// RelK
[] p2 >= 1 -> p2 = p2 - 1; p3 = p3 + 1; p7 = p7 + 1
// GetK2
[] p7 >= 1 && p3 >= 1 -> p3 = p3 - 1; p4 = p4 + 1; p7 = p7 - 1
// RBag
[] p4 >= 1 -> p4 = p4 - 1; p5 = p5 + 1; p8 = p8 + 1
// RKey
[] p5 >= 1 -> p5 = p5 - 1; p6 = p6 + 1; p7 = p7 + 1
// Enter
[] p6 >= 1 -> p0 = p0 + 1; p6 = p6 - 1

// SwimmingPool-PT-09-LTLCardinality-14
// ap a0 := p8 <= p7
// ap a1 := 2 <= p3
// ap a2 := p7 <= p1
// spec: "((!(X(G((a0 | a1))))) U (!(a2)))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans(q0, q2): p7 <= p1
trans!(q1, q1): p8 <= p7
trans!(q1, q1): 2 <= p3
trans!(q2, q1): p7 > p1 && p8 <= p7
trans!(q2, q1): p7 > p1 && 2 <= p3
trans!(q2, q2): p7 <= p1

rank(q0):
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) = 90 && (((p2 + p3) + p4) + p8) = 135 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 < 1 && p1 < 1 && p2 < 1 && p3 < 1 && p4 < 1 && p5 < 1 -> 0
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) < 180 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) > 180 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) < 90 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) > 90 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) = 90 && (((p2 + p3) + p4) + p8) < 135 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) = 90 && (((p2 + p3) + p4) + p8) > 135 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) = 90 && (((p2 + p3) + p4) + p8) = 135 && p0 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) = 90 && (((p2 + p3) + p4) + p8) = 135 && p0 >= 0 && p1 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) = 90 && (((p2 + p3) + p4) + p8) = 135 && p0 >= 0 && p1 >= 0 && p2 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) = 90 && (((p2 + p3) + p4) + p8) = 135 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) = 90 && (((p2 + p3) + p4) + p8) = 135 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) = 90 && (((p2 + p3) + p4) + p8) = 135 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) = 90 && (((p2 + p3) + p4) + p8) = 135 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) = 90 && (((p2 + p3) + p4) + p8) = 135 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 < 1 && p1 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) = 90 && (((p2 + p3) + p4) + p8) = 135 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 < 1 && p1 < 1 && p2 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) = 90 && (((p2 + p3) + p4) + p8) = 135 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 < 1 && p1 < 1 && p2 < 1 && p3 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) = 90 && (((p2 + p3) + p4) + p8) = 135 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 < 1 && p1 < 1 && p2 < 1 && p3 < 1 && p4 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) = 90 && (((p2 + p3) + p4) + p8) = 135 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 < 1 && p1 < 1 && p2 < 1 && p3 < 1 && p4 < 1 && p5 >= 1 -> inf

rank(q2):
  [] true -> inf

rank(q1):
