// MCC instance Sudoku-PT-AN01
// 4 places, 1 transitions
// places: p0=Rows_0_0, p1=Board_0_0_0, p2=Cells_0_0, p3=Columns_0_0

init: p0 == 1 && p1 == 0 && p2 == 1 && p3 == 1

// select_0_0_0
[] p2 >= 1 && p3 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p2 = p2 - 1; p3 = p3 - 1
// deadlock: stutter (MCC semantics)
[] p3 <= 0 -> p0 = p0

// Sudoku-PT-AN01-LTLCardinality-08
// ap a0 := 1 <= p0
// ap a1 := p0 <= p2
// spec: "X(G(F(G(!(F((a0 & !(X(F(a1))))))))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans(q0, q0): true
trans(q0, q1): 1 <= p0 && p0 > p2
trans!(q1, q1): 1 <= p0 && p0 > p2
trans!(q1, q2): 1 > p0 && p0 > p2
trans(q2, q1): 1 <= p0 && p0 > p2
trans(q2, q2): 1 > p0 && p0 > p2

rank(q0):
  [] ((-1 * p0) + p2) = 0 -> 0
  [] ((-1 * p0) + p2) < 0 -> inf
  [] ((-1 * p0) + p2) > 0 -> inf

rank(q1):
  [] true -> inf

rank(q2):
  [] true -> inf
