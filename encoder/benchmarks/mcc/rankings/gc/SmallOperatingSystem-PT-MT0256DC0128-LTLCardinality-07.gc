// MCC instance SmallOperatingSystem-PT-MT0256DC0128
// 9 places, 8 transitions
// places: p0=TaskOnDisk, p1=FreeMemSegment, p2=DiskControllerUnit, p3=TransferToDisk, p4=TaskReady, p5=TaskSuspended, p6=CPUUnit, p7=ExecutingTask, p8=LoadingMem

init: p0 == 256 && p1 == 256 && p2 == 128 && p3 == 0 && p4 == 0 && p5 == 0 && p6 == 256 && p7 == 0 && p8 == 0

// startLoading
[] p2 >= 1 && p1 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 - 1; p2 = p2 - 1; p8 = p8 + 1
// endLoading
[] p8 >= 1 -> p0 = p0 + 1; p2 = p2 + 1; p4 = p4 + 1; p8 = p8 - 1
// endUnload
[] p3 >= 1 -> p0 = p0 + 1; p2 = p2 + 1; p3 = p3 - 1; p4 = p4 + 1
// startUnload
[] p2 >= 1 && p0 >= 1 && p5 >= 1 -> p0 = p0 - 1; p2 = p2 - 1; p3 = p3 + 1; p5 = p5 - 1
// startFirst
[] p6 >= 1 && p4 >= 1 -> p4 = p4 - 1; p6 = p6 - 1; p7 = p7 + 1
// startNext
[] p6 >= 1 && p5 >= 1 -> p5 = p5 - 1; p6 = p6 - 1; p7 = p7 + 1
// suspend
[] p7 >= 1 -> p5 = p5 + 1; p6 = p6 + 1; p7 = p7 - 1
// freeMemory
[] p4 >= 1 -> p1 = p1 + 1; p4 = p4 - 1

// SmallOperatingSystem-PT-MT0256DC0128-LTLCardinality-07
// ap a0 := p8 <= p5
// ap a1 := 1 <= p7
// ap a2 := 2 <= p1
// spec: "!((((a0 | G(a1))) U (!(X(X(a2))))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans(q0, q0): p8 <= p5
trans(q0, q1): true
trans(q0, q2): p8 > p5 && 1 <= p7
trans(q1, q3): true
trans(q2, q2): 1 <= p7
trans(q2, q5): 1 <= p7
trans(q3, q4): 2 > p1
trans!(q4, q4): true
trans(q5, q6): 1 <= p7
trans(q6, q7): 1 <= p7 && 2 > p1
trans!(q7, q7): 1 <= p7

rank(q0):
  [] p4 = 0 && p7 = 0 && p8 <= 1 && p3 = 0 && p5 = 0 && ((((-1 * p0) + p1) + p4) + p7) = 0 && (p0 + p8) = 256 -> 0
  [] p4 < 0 -> inf
  [] p4 > 0 -> inf
  [] p4 = 0 && p7 < 0 -> inf
  [] p4 = 0 && p7 > 0 -> inf
  [] p4 = 0 && p7 = 0 && p8 > 1 -> inf
  [] p4 = 0 && p7 = 0 && p8 <= 1 && p3 < 0 -> inf
  [] p4 = 0 && p7 = 0 && p8 <= 1 && p3 > 0 -> inf
  [] p4 = 0 && p7 = 0 && p8 <= 1 && p3 = 0 && p5 < 0 -> inf
  [] p4 = 0 && p7 = 0 && p8 <= 1 && p3 = 0 && p5 > 0 -> inf
  [] p4 = 0 && p7 = 0 && p8 <= 1 && p3 = 0 && p5 = 0 && ((((-1 * p0) + p1) + p4) + p7) < 0 -> inf
  [] p4 = 0 && p7 = 0 && p8 <= 1 && p3 = 0 && p5 = 0 && ((((-1 * p0) + p1) + p4) + p7) > 0 -> inf
  [] p4 = 0 && p7 = 0 && p8 <= 1 && p3 = 0 && p5 = 0 && ((((-1 * p0) + p1) + p4) + p7) = 0 && (p0 + p8) < 256 -> inf
  [] p4 = 0 && p7 = 0 && p8 <= 1 && p3 = 0 && p5 = 0 && ((((-1 * p0) + p1) + p4) + p7) = 0 && (p0 + p8) > 256 -> inf

rank(q1):
  [] p1 >= 254 -> 0
  [] p1 < 254 -> inf

rank(q2):
