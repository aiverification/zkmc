// MCC instance SwimmingPool-PT-06
// 9 places, 7 transitions
// places: p0=Entered, p1=WaitBag, p2=Undress, p3=InBath, p4=Dress, p5=Dressed, p6=Out, p7=Cabins, p8=Bags

init: p0 == 0 && p1 == 0 && p2 == 0 && p3 == 0 && p4 == 0 && p5 == 0 && p6 == 120 && p7 == 60 && p8 == 90

// GetK
[] p7 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p7 = p7 - 1
// GetB
[] p8 >= 1 && p1 >= 1 -> p1 = p1 - 1; p2 = p2 + 1; p8 = p8 - 1
// RelK
[] p2 >= 1 -> p2 = p2 - 1; p3 = p3 + 1; p7 = p7 + 1
// GetK2
[] p7 >= 1 && p3 >= 1 -> p3 = p3 - 1; p4 = p4 + 1; p7 = p7 - 1
// RBag
[] p4 >= 1 -> p4 = p4 - 1; p5 = p5 + 1; p8 = p8 + 1
// RKey
[] p5 >= 1 -> p5 = p5 - 1; p6 = p6 + 1; p7 = p7 + 1
// Enter
[] p6 >= 1 -> p0 = p0 + 1; p6 = p6 - 1

// SwimmingPool-PT-06-LTLCardinality-08
// ap a0 := 2 <= p6
// ap a1 := 1 <= p3
// ap a2 := p5 <= p0
// ap a3 := 1 <= p1
// spec: "(a0 | X(a1) | F(a2) | !(F(!(a3))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q2
trans(q0, q1): p5 > p0 && 1 > p3
trans!(q1, q1): p5 > p0
trans(q2, q0): 2 > p6 && 1 > p1 && p5 > p0
trans(q2, q3): 2 > p6 && 1 <= p1 && p5 > p0
trans(q3, q1): 1 > p1 && p5 > p0 && 1 > p3
trans(q3, q4): 1 <= p1 && p5 > p0 && 1 > p3
trans(q4, q1): 1 > p1 && p5 > p0
trans(q4, q4): 1 <= p1 && p5 > p0

rank(q2):
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 120 && ((((p1 + p2) + p4) + p5) + p7) = 60 && (((p2 + p3) + p4) + p8) = 90 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 < 1 && p1 < 1 && p2 < 1 && p3 < 1 && p4 < 1 && p5 <= p0 -> 0
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) < 120 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) > 120 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 120 && ((((p1 + p2) + p4) + p5) + p7) < 60 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 120 && ((((p1 + p2) + p4) + p5) + p7) > 60 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 120 && ((((p1 + p2) + p4) + p5) + p7) = 60 && (((p2 + p3) + p4) + p8) < 90 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 120 && ((((p1 + p2) + p4) + p5) + p7) = 60 && (((p2 + p3) + p4) + p8) > 90 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 120 && ((((p1 + p2) + p4) + p5) + p7) = 60 && (((p2 + p3) + p4) + p8) = 90 && p1 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 120 && ((((p1 + p2) + p4) + p5) + p7) = 60 && (((p2 + p3) + p4) + p8) = 90 && p1 >= 0 && p2 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 120 && ((((p1 + p2) + p4) + p5) + p7) = 60 && (((p2 + p3) + p4) + p8) = 90 && p1 >= 0 && p2 >= 0 && p3 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 120 && ((((p1 + p2) + p4) + p5) + p7) = 60 && (((p2 + p3) + p4) + p8) = 90 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 120 && ((((p1 + p2) + p4) + p5) + p7) = 60 && (((p2 + p3) + p4) + p8) = 90 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 120 && ((((p1 + p2) + p4) + p5) + p7) = 60 && (((p2 + p3) + p4) + p8) = 90 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 120 && ((((p1 + p2) + p4) + p5) + p7) = 60 && (((p2 + p3) + p4) + p8) = 90 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 < 1 && p1 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 120 && ((((p1 + p2) + p4) + p5) + p7) = 60 && (((p2 + p3) + p4) + p8) = 90 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 < 1 && p1 < 1 && p2 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 120 && ((((p1 + p2) + p4) + p5) + p7) = 60 && (((p2 + p3) + p4) + p8) = 90 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 < 1 && p1 < 1 && p2 < 1 && p3 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 120 && ((((p1 + p2) + p4) + p5) + p7) = 60 && (((p2 + p3) + p4) + p8) = 90 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 < 1 && p1 < 1 && p2 < 1 && p3 < 1 && p4 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 120 && ((((p1 + p2) + p4) + p5) + p7) = 60 && (((p2 + p3) + p4) + p8) = 90 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 < 1 && p1 < 1 && p2 < 1 && p3 < 1 && p4 < 1 && p5 > p0 -> inf

