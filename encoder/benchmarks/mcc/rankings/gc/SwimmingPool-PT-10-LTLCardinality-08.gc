  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) < 200 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) > 200 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 200 && ((((p1 + p2) + p4) + p5) + p7) < 100 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 200 && ((((p1 + p2) + p4) + p5) + p7) > 100 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 200 && ((((p1 + p2) + p4) + p5) + p7) = 100 && (((p2 + p3) + p4) + p8) < 150 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 200 && ((((p1 + p2) + p4) + p5) + p7) = 100 && (((p2 + p3) + p4) + p8) > 150 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 200 && ((((p1 + p2) + p4) + p5) + p7) = 100 && (((p2 + p3) + p4) + p8) = 150 && p0 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 200 && ((((p1 + p2) + p4) + p5) + p7) = 100 && (((p2 + p3) + p4) + p8) = 150 && p0 >= 0 && p2 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 200 && ((((p1 + p2) + p4) + p5) + p7) = 100 && (((p2 + p3) + p4) + p8) = 150 && p0 >= 0 && p2 >= 0 && p3 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 200 && ((((p1 + p2) + p4) + p5) + p7) = 100 && (((p2 + p3) + p4) + p8) = 150 && p0 >= 0 && p2 >= 0 && p3 >= 0 && p4 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 200 && ((((p1 + p2) + p4) + p5) + p7) = 100 && (((p2 + p3) + p4) + p8) = 150 && p0 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 200 && ((((p1 + p2) + p4) + p5) + p7) = 100 && (((p2 + p3) + p4) + p8) = 150 && p0 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 200 && ((((p1 + p2) + p4) + p5) + p7) = 100 && (((p2 + p3) + p4) + p8) = 150 && p0 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 < 1 && p1 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 200 && ((((p1 + p2) + p4) + p5) + p7) = 100 && (((p2 + p3) + p4) + p8) = 150 && p0 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 < 1 && p1 < 1 && p2 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 200 && ((((p1 + p2) + p4) + p5) + p7) = 100 && (((p2 + p3) + p4) + p8) = 150 && p0 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p5 >= 0 && p0 < 1 && p1 < 1 && p2 < 1 && p4 >= 1 -> inf
