trans(q2, q5): p4 >= 1
trans!(q3, q3): p7 < 1
trans!(q3, q3): p0 < 1
trans!(q4, q4): p7 >= 1 && p0 >= 1
trans(q5, q4): p7 >= 1 && p0 >= 1
trans(q5, q5): p4 >= 1
trans(q5, q6): p4 < 1
trans(q6, q4): p7 >= 1 && p0 >= 1 && p4 >= 1
trans(q6, q5): p4 >= 1
trans(q6, q6): p4 < 1

