// MCC instance SwimmingPool-PT-02
// 9 places, 7 transitions
// places: p0=Entered, p1=WaitBag, p2=Undress, p3=InBath, p4=Dress, p5=Dressed, p6=Out, p7=Cabins, p8=Bags

init: p0 == 0 && p1 == 0 && p2 == 0 && p3 == 0 && p4 == 0 && p5 == 0 && p6 == 40 && p7 == 20 && p8 == 30

// GetK
[] p7 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p7 = p7 - 1
// GetB
[] p8 >= 1 && p1 >= 1 -> p1 = p1 - 1; p2 = p2 + 1; p8 = p8 - 1
// RelK
[] p2 >= 1 -> p2 = p2 - 1; p3 = p3 + 1; p7 = p7 + 1
// GetK2
[] p7 >= 1 && p3 >= 1 -> p3 = p3 - 1; p4 = p4 + 1; p7 = p7 - 1
// RBag
[] p4 >= 1 -> p4 = p4 - 1; p5 = p5 + 1; p8 = p8 + 1
// RKey
[] p5 >= 1 -> p5 = p5 - 1; p6 = p6 + 1; p7 = p7 + 1
// Enter
[] p6 >= 1 -> p0 = p0 + 1; p6 = p6 - 1

// SwimmingPool-PT-02-LTLCardinality-00
// ap a0 := p6 <= p4
// ap a1 := p1 <= p5
// ap a2 := 1 <= p7
// spec: "((G((X(!(X(X(a0)))) | (a1 & X(a2))))) U (a1))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans!(q0, q0): p1 > p5
trans!(q0, q1): p1 > p5
trans!(q0, q2): p1 > p5
trans(q1, q3): true
trans(q2, q1): p1 > p5
trans(q2, q2): true
trans(q2, q6): p1 <= p5
trans(q3, q4): true
trans(q4, q5): p6 <= p4
trans!(q5, q5): true
trans(q6, q3): 1 > p7

rank(q0):
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 40 && ((((p1 + p2) + p4) + p5) + p7) = 20 && (((p2 + p3) + p4) + p8) = 30 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p0 < 1 && p2 < 1 && p3 < 1 && p4 < 1 && p5 < 1 && p1 <= p5 -> 0
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) < 40 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) > 40 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 40 && ((((p1 + p2) + p4) + p5) + p7) < 20 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 40 && ((((p1 + p2) + p4) + p5) + p7) > 20 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 40 && ((((p1 + p2) + p4) + p5) + p7) = 20 && (((p2 + p3) + p4) + p8) < 30 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 40 && ((((p1 + p2) + p4) + p5) + p7) = 20 && (((p2 + p3) + p4) + p8) > 30 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 40 && ((((p1 + p2) + p4) + p5) + p7) = 20 && (((p2 + p3) + p4) + p8) = 30 && p0 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 40 && ((((p1 + p2) + p4) + p5) + p7) = 20 && (((p2 + p3) + p4) + p8) = 30 && p0 >= 0 && p1 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 40 && ((((p1 + p2) + p4) + p5) + p7) = 20 && (((p2 + p3) + p4) + p8) = 30 && p0 >= 0 && p1 >= 0 && p2 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 40 && ((((p1 + p2) + p4) + p5) + p7) = 20 && (((p2 + p3) + p4) + p8) = 30 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 40 && ((((p1 + p2) + p4) + p5) + p7) = 20 && (((p2 + p3) + p4) + p8) = 30 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 40 && ((((p1 + p2) + p4) + p5) + p7) = 20 && (((p2 + p3) + p4) + p8) = 30 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p0 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 40 && ((((p1 + p2) + p4) + p5) + p7) = 20 && (((p2 + p3) + p4) + p8) = 30 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p0 < 1 && p2 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 40 && ((((p1 + p2) + p4) + p5) + p7) = 20 && (((p2 + p3) + p4) + p8) = 30 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p0 < 1 && p2 < 1 && p3 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 40 && ((((p1 + p2) + p4) + p5) + p7) = 20 && (((p2 + p3) + p4) + p8) = 30 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p0 < 1 && p2 < 1 && p3 < 1 && p4 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 40 && ((((p1 + p2) + p4) + p5) + p7) = 20 && (((p2 + p3) + p4) + p8) = 30 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p0 < 1 && p2 < 1 && p3 < 1 && p4 < 1 && p5 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 40 && ((((p1 + p2) + p4) + p5) + p7) = 20 && (((p2 + p3) + p4) + p8) = 30 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p0 < 1 && p2 < 1 && p3 < 1 && p4 < 1 && p5 < 1 && p1 > p5 -> inf

