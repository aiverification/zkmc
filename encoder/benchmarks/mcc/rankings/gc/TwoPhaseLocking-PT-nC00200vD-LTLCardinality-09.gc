// MCC instance TwoPhaseLocking-PT-nC00200vD
// 8 places, 6 transitions
// places: p0=resB, p1=haveA, p2=haveA2, p3=resA, p4=haveB, p5=Clients, p6=haveAandB, p7=haveA2andB

init: p0 == 100 && p1 == 0 && p2 == 0 && p3 == 100 && p4 == 0 && p5 == 200 && p6 == 0 && p7 == 0

// relB
[] p7 >= 1 -> p0 = p0 + 1; p2 = p2 + 1; p7 = p7 - 1
// lockB
[] p1 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 - 1; p6 = p6 + 1
// lockA
[] p5 >= 1 && p3 >= 1 -> p1 = p1 + 1; p3 = p3 - 1; p5 = p5 - 1
// relA2
[] p2 >= 1 -> p2 = p2 - 1; p3 = p3 + 1; p5 = p5 + 1
// relA
[] p6 >= 1 -> p3 = p3 + 1; p4 = p4 + 1; p6 = p6 - 1
// lockA2
[] p4 >= 1 && p3 >= 1 -> p3 = p3 - 1; p4 = p4 - 1; p7 = p7 + 1
// deadlock: stutter (MCC semantics)
[] p0 <= 0 && p2 <= 0 && p3 <= 0 && p6 <= 0 && p7 <= 0 -> p0 = p0

// TwoPhaseLocking-PT-nC00200vD-LTLCardinality-09
// ap a0 := p4 <= p1
// ap a1 := p0 <= p3
// ap a2 := p1 <= p2
// spec: "(a0 & X(!((a1 & !(G(a2))))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q1
trans!(q0, q0): true
trans(q1, q0): p4 > p1
trans(q1, q3): p4 <= p1
trans(q2, q0): p1 > p2
trans(q2, q2): p1 <= p2
trans(q3, q0): p0 <= p3 && p1 > p2
trans(q3, q2): p0 <= p3 && p1 <= p2

rank(q1):
  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) = 100 && p4 = 0 && (p1 + p5) = 200 && p6 = 0 && p7 = 0 -> 0
  [] p5 < 200 -> inf
  [] p5 > 200 -> inf
  [] p5 = 200 && p0 < 100 -> inf
