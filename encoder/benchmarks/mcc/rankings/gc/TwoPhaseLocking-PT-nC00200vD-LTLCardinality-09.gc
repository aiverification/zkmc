  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) = 100 && p4 = 0 && (p1 + p5) < 200 -> inf
  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) = 100 && p4 = 0 && (p1 + p5) > 200 -> inf
  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) = 100 && p4 = 0 && (p1 + p5) = 200 && p6 < 0 -> inf
  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) = 100 && p4 = 0 && (p1 + p5) = 200 && p6 > 0 -> inf
  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) = 100 && p4 = 0 && (p1 + p5) = 200 && p6 = 0 && p7 < 0 -> inf
  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) = 100 && p4 = 0 && (p1 + p5) = 200 && p6 = 0 && p7 > 0 -> inf

rank(q0):
  [] true -> inf

