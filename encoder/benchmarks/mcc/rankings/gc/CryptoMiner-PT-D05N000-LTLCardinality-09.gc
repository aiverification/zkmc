init: p0 == 0 && p1 == 0 && p2 == 0 && p3 == 0 && p4 == 0 && p5 == 0 && p6 == 1 && p7 == 0 && p8 == 0 && p9 == 0 && p10 == 0 && p11 == 0

// Compute_0
[] p1 >= 1 && p7 >= 1 -> p1 = p1 - 1; p2 = p2 + 1
