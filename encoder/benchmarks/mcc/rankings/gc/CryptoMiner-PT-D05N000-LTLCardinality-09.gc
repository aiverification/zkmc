// ComputeFirst_5
[] p6 >= 1 -> p1 = p1 + 1
// Exit_6
[] p11 >= 1 -> p11 = p11 - 1
// Go_7
[] p6 >= 1 -> p6 = p6 - 1; p7 = p7 + 1
// Go_8
[] p7 >= 1 -> p7 = p7 - 1; p8 = p8 + 1
