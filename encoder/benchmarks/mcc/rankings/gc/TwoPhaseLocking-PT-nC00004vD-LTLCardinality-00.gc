  [] p5 = 4 && p0 = 2 && p2 = 0 && p4 = 0 && (p1 + p5) > 4 -> inf
  [] p5 = 4 && p0 = 2 && p2 = 0 && p4 = 0 && (p1 + p5) = 4 && p6 < 0 -> inf
  [] p5 = 4 && p0 = 2 && p2 = 0 && p4 = 0 && (p1 + p5) = 4 && p6 > 0 -> inf
  [] p5 = 4 && p0 = 2 && p2 = 0 && p4 = 0 && (p1 + p5) = 4 && p6 = 0 && p7 < 0 -> inf
  [] p5 = 4 && p0 = 2 && p2 = 0 && p4 = 0 && (p1 + p5) = 4 && p6 = 0 && p7 > 0 -> inf

