trans!(q0, q0): true
trans!(q1, q0): 2 > p5 && 1 > p3
trans!(q1, q1): 2 > p5 && 1 <= p3
trans(q2, q5): true
trans(q3, q0): p6 > p3
trans(q3, q3): p6 <= p3
trans(q4, q0): 2 > p5 && 1 > p3 && p6 > p3
trans(q4, q1): 2 > p5 && 1 <= p3 && p6 > p3
trans(q4, q3): 2 > p5 && 1 > p3 && p6 <= p3
