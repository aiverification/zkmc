trans(q5, q0): 3 > p4 && 2 > p5 && 1 > p3 && p6 > p3
trans(q5, q1): 3 > p4 && 2 > p5 && 1 <= p3 && p6 > p3
trans(q5, q3): 3 > p4 && 2 > p5 && 1 > p3 && p6 <= p3
trans(q5, q4): 3 > p4 && 2 > p5 && 1 <= p3 && p6 <= p3

rank(q2):
  [] p5 = 4 && p0 = 2 && p2 = 0 && p4 = 0 && (p1 + p5) = 4 && p6 = 0 && p7 = 0 -> 0
  [] p5 < 4 -> inf
  [] p5 > 4 -> inf
