// MCC instance RefineWMG-PT-002003
// 14 places, 11 transitions
// places: p0=p, p1=pprime, p2=psecond, p3=pterce, p4=p1, p5=p2, p6=p3, p7=p4, p8=p5, p9=p6, p10=p7, p11=p8, p12=p9, p13=p10

init: p0 == 0 && p1 == 7 && p2 == 5 && p3 == 0 && p4 == 0 && p5 == 0 && p6 == 3 && p7 == 3 && p8 == 0 && p9 == 0 && p10 == 0 && p11 == 3 && p12 == 3 && p13 == 0

// t
[] p4 >= 5 -> p1 = p1 + 5; p4 = p4 - 5
// tprime
[] p3 >= 3 -> p2 = p2 + 3; p3 = p3 - 3
// tsecond
[] p1 >= 2 && p2 >= 2 -> p0 = p0 + 2; p1 = p1 - 2; p2 = p2 - 2; p3 = p3 + 2
// t1
[] p6 >= 1 && p7 >= 1 && p9 >= 1 -> p4 = p4 + 1; p5 = p5 + 1; p6 = p6 - 1; p7 = p7 - 1; p8 = p8 + 1; p9 = p9 - 1
// t2
[] p5 >= 1 -> p5 = p5 - 1; p6 = p6 + 1
// t3
[] p8 >= 1 -> p7 = p7 + 1; p8 = p8 - 1
// t4
[] p7 >= 1 -> p7 = p7 - 1; p8 = p8 + 1
// t5
[] p0 >= 1 && p11 >= 1 && p12 >= 1 -> p0 = p0 - 1; p9 = p9 + 1; p10 = p10 + 1; p11 = p11 - 1; p12 = p12 - 1; p13 = p13 + 1
// t6
[] p10 >= 1 -> p10 = p10 - 1; p11 = p11 + 1
// t7
[] p13 >= 1 -> p12 = p12 + 1; p13 = p13 - 1
// t8
[] p12 >= 1 -> p12 = p12 - 1; p13 = p13 + 1

// RefineWMG-PT-002003-LTLCardinality-13
// ap a0 := 3 <= p8
// spec: "!(G(X((a0 | !(X(!(a0)))))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q1
trans!(q0, q2): 3 <= p8
trans(q1, q2): true
trans!(q2, q0): 3 > p8
trans!(q2, q2): 3 <= p8

rank(q1):
  [] p13 = 0 && p3 = 0 && p8 = 0 -> 1
  [] p13 < 0 -> inf
  [] p13 > 0 -> inf
  [] p13 = 0 && p3 < 0 -> inf
  [] p13 = 0 && p3 > 0 -> inf
  [] p13 = 0 && p3 = 0 && p8 < 0 -> inf
  [] p13 = 0 && p3 = 0 && p8 > 0 -> inf

rank(q0):
  [] p3 <= 4 && p8 <= 2 -> 0
  [] p3 > 4 -> inf
  [] p3 <= 4 && p8 > 2 -> inf

rank(q2):
  [] p3 <= 2 && p8 <= 1 -> 1
  [] p3 > 2 -> inf
  [] p3 <= 2 && p8 > 1 -> inf
