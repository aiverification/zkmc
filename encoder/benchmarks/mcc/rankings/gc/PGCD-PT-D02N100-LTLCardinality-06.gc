trans(q11, q10): 1 > p2 && p2 <= p0 && 1 > p0 && 2 > p4
trans(q11, q11): 1 <= p2 && 1 > p0 && 2 > p4
trans(q11, q11): p2 <= p0 && 1 > p0 && 2 > p4
trans(q11, q16): 1 > p2 && p2 <= p0 && 1 > p0 && 2 > p4
trans(q12, q6): 1 > p2 && p2 > p0
trans(q12, q12): 1 > p2 && p2 <= p0
trans(q13, q5): 1 > p2 && 1 <= p0
trans(q13, q6): 1 <= p0
trans(q13, q13): 1 > p0
trans(q14, q5): 1 > p2 && 2 > p4
trans(q15, q14): 1 > p2 && 2 > p4
trans!(q16, q15): 1 > p2 && 2 > p4
