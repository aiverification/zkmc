// ap a2 := 1 <= p0
// ap a3 := 2 <= p4
// spec: "(((((a0) U (a1)) & G(!(a2)))) U ((G(F(a1)) | X(X(a3)))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans(q0, q1): 1 > p2 && p2 > p0
trans(q0, q1): 1 <= p0
trans(q0, q2): 1 > p2 && p2 <= p0 && 1 > p0
trans(q0, q3): 1 <= p2 && 1 > p0
trans(q0, q3): p2 <= p0 && 1 > p0
trans(q1, q4): true
