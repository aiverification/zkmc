trans(q3, q11): p2 <= p0 && 1 > p0
trans(q4, q5): 1 > p2 && 2 > p4
trans(q4, q6): 2 > p4
trans!(q5, q5): 1 > p2
trans(q6, q5): 1 > p2
trans(q6, q6): true
trans(q7, q5): 1 > p2 && 2 > p4
trans(q7, q6): 1 > p2 && p2 > p0 && 2 > p4
trans(q7, q12): 1 > p2 && p2 <= p0 && 2 > p4
