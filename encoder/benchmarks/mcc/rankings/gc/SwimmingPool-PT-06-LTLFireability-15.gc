trans(q0, q2): p7 < 1
trans(q0, q2): p3 < 1
trans(q0, q3): p4 >= 1 && p6 >= 1 && p7 < 1
trans(q0, q3): p4 >= 1 && p6 >= 1 && p3 < 1
trans!(q1, q1): true
trans(q2, q4): p4 >= 1 && p2 < 1
trans(q3, q3): p6 >= 1 && p7 < 1
trans(q3, q3): p6 >= 1 && p3 < 1
trans(q3, q5): p6 >= 1 && p7 >= 1 && p3 >= 1
trans!(q4, q4): p2 < 1
trans!(q5, q5): p6 >= 1

