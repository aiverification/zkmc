// MCC instance Sudoku-PT-BN01
// 5 places, 1 transitions
// places: p0=Rows_0_0, p1=Board_0_0_0, p2=Regions_0_0, p3=Cells_0_0, p4=Columns_0_0

init: p0 == 1 && p1 == 0 && p2 == 1 && p3 == 1 && p4 == 1

// select_0_0_0_0
[] p3 >= 1 && p4 >= 1 && p2 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p2 = p2 - 1; p3 = p3 - 1; p4 = p4 - 1
// deadlock: stutter (MCC semantics)
[] p4 <= 0 -> p0 = p0

// Sudoku-PT-BN01-LTLFireability-07
// ap e0 := p3 >= 1 && p4 >= 1 && p2 >= 1 && p0 >= 1
// spec: "((!((((e0)) U (X(G((e0))))))) U (X(!(X(X(((F((e0))) U ((e0)))))))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans!(q0, q0): p3 >= 1 && p4 >= 1 && p2 >= 1 && p0 >= 1
trans!(q0, q1): p3 >= 1 && p4 >= 1 && p2 >= 1 && p0 >= 1
trans!(q0, q2): p3 < 1
trans!(q0, q2): p4 < 1
trans!(q0, q2): p2 < 1
trans!(q0, q2): p0 < 1
trans(q1, q3): true
trans(q2, q0): p3 >= 1 && p4 >= 1 && p2 >= 1 && p0 >= 1
trans(q2, q1): p3 >= 1 && p4 >= 1 && p2 >= 1 && p0 >= 1
trans(q2, q2): p3 < 1
trans(q2, q2): p4 < 1
trans(q2, q2): p2 < 1
trans(q2, q2): p0 < 1
trans!(q3, q3): p3 >= 1 && p4 >= 1 && p2 >= 1 && p0 >= 1

rank(q0):
  [] ((-1 * p0) + p4) = 0 && p4 >= 0 && p4 <= 1 -> (1 + p0)
  [] ((-1 * p0) + p4) < 0 -> inf
  [] ((-1 * p0) + p4) > 0 -> inf
  [] ((-1 * p0) + p4) = 0 && p4 < 0 -> inf
  [] ((-1 * p0) + p4) = 0 && p4 >= 0 && p4 > 1 -> inf

rank(q1):
  [] p0 = 0 -> (0 + p0)
  [] p0 < 0 -> inf
  [] p0 > 0 -> inf

rank(q2):
  [] p0 = 0 && p4 = 0 -> (0 + p4)
  [] p0 < 0 -> inf
  [] p0 > 0 -> inf
  [] p0 = 0 && p4 < 0 -> inf
  [] p0 = 0 && p4 > 0 -> inf

rank(q3):
  [] p0 = 0 -> (0 + p0)
  [] p0 < 0 -> inf
  [] p0 > 0 -> inf
