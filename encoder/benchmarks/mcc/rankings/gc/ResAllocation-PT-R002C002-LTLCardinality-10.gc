// MCC instance ResAllocation-PT-R002C002
// 8 places, 6 transitions
// places: p0=p_0_0, p1=r_0_0, p2=p_0_1, p3=r_0_1, p4=p_1_0, p5=r_1_0, p6=p_1_1, p7=r_1_1

init: p0 == 0 && p1 == 1 && p2 == 0 && p3 == 1 && p4 == 0 && p5 == 1 && p6 == 0 && p7 == 1

// t_0_0
[] p1 >= 1 -> p0 = p0 + 1; p1 = p1 - 1
// t_0_1
[] p0 >= 1 && p3 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p2 = p2 + 1; p3 = p3 - 1
// t_0_2
[] p2 >= 1 -> p2 = p2 - 1; p3 = p3 + 1
// t_1_0
[] p4 >= 1 -> p1 = p1 + 1; p4 = p4 - 1; p5 = p5 + 1
// t_1_1
[] p6 >= 1 && p1 >= 1 && p5 >= 1 -> p1 = p1 - 1; p3 = p3 + 1; p4 = p4 + 1; p5 = p5 - 1; p6 = p6 - 1; p7 = p7 + 1
// t_1_2
[] p3 >= 1 && p7 >= 1 -> p3 = p3 - 1; p6 = p6 + 1; p7 = p7 - 1
// deadlock: stutter (MCC semantics)
[] p1 <= 0 && p2 <= 0 && p3 <= 0 && p4 <= 0 -> p0 = p0

// ResAllocation-PT-R002C002-LTLCardinality-10
// ap a0 := p5 <= p2
// ap a1 := 2 <= p3
// ap a2 := 1 <= p1
// spec: "(F(X(G(a0))) | ((((X(F(a1))) U (a1))) U (a2)))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans!(q0, q0): 1 > p1 && p5 > p2
trans!(q0, q1): 1 > p1 && p5 <= p2
trans!(q0, q2): 1 > p1 && p5 > p2 && 2 > p3
trans!(q0, q3): 1 > p1 && p5 <= p2 && 2 > p3
trans(q1, q0): 1 > p1 && p5 > p2
trans(q1, q1): 1 > p1 && p5 <= p2
trans(q1, q2): 1 > p1 && p5 > p2 && 2 > p3
trans(q1, q3): 1 > p1 && p5 <= p2 && 2 > p3
trans!(q2, q2): p5 > p2 && 2 > p3
trans!(q2, q3): p5 <= p2 && 2 > p3
trans(q3, q2): p5 > p2 && 2 > p3
trans(q3, q3): p5 <= p2 && 2 > p3

rank(q0):
  [] p0 = 0 && p1 = 1 -> 0
  [] p0 < 0 -> inf
  [] p0 > 0 -> inf
  [] p0 = 0 && p1 < 1 -> inf
  [] p0 = 0 && p1 > 1 -> inf

rank(q1):
  [] true -> inf

rank(q2):
  [] true -> inf

rank(q3):
  [] true -> inf
