trans!(q0, q0): true
trans(q1, q2): true
trans(q2, q4): p4 > p7
trans(q3, q0): 3 > p4
trans(q3, q0): 1 > p1
trans(q3, q0): 1 > p2
trans(q3, q5): 3 <= p4 && 1 <= p1 && 1 <= p2
trans(q4, q0): 1 > p2
trans(q4, q3): 1 <= p2
trans(q5, q0): 1 > p2
trans(q5, q5): 1 <= p2

