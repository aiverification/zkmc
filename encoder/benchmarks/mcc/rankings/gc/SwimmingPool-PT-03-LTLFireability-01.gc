trans(q1, q2): true
trans(q1, q3): p8 < 1
trans(q1, q3): p1 < 1
trans!(q2, q2): p7 >= 1 && p3 >= 1
trans!(q3, q3): p8 < 1
trans!(q3, q3): p1 < 1

