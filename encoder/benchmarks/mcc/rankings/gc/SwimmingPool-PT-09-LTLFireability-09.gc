  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 180 && ((((p1 + p2) + p4) + p5) + p7) = 90 && (((p2 + p3) + p4) + p8) = 135 && p0 >= 0 && p1 >= 0 && p2 < 0 -> inf
