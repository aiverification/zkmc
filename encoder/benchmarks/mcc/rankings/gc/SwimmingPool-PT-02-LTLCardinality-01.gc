trans!(q0, q0): p4 <= p5
trans!(q1, q1): p4 > p5
trans!(q2, q1): 2 > p1 && p4 > p5
trans!(q2, q2): 2 <= p1
trans!(q3, q0): 2 > p1 && p4 <= p5
trans!(q3, q1): 2 > p1 && p4 > p5
trans!(q3, q2): 2 <= p1 && p4 > p5
trans!(q3, q3): 2 <= p1 && p4 <= p5

