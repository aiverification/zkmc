  [] p1 = 0 && p10 = 0 && p11 = 0 && p2 = 0 && p3 > 0 -> inf
  [] p1 = 0 && p10 = 0 && p11 = 0 && p2 = 0 && p3 = 0 && p6 < 1 -> inf
  [] p1 = 0 && p10 = 0 && p11 = 0 && p2 = 0 && p3 = 0 && p6 > 1 -> inf
  [] p1 = 0 && p10 = 0 && p11 = 0 && p2 = 0 && p3 = 0 && p6 = 1 && p7 < 0 -> inf
  [] p1 = 0 && p10 = 0 && p11 = 0 && p2 = 0 && p3 = 0 && p6 = 1 && p7 > 0 -> inf
  [] p1 = 0 && p10 = 0 && p11 = 0 && p2 = 0 && p3 = 0 && p6 = 1 && p7 = 0 && p8 < 0 -> inf
  [] p1 = 0 && p10 = 0 && p11 = 0 && p2 = 0 && p3 = 0 && p6 = 1 && p7 = 0 && p8 > 0 -> inf
  [] p1 = 0 && p10 = 0 && p11 = 0 && p2 = 0 && p3 = 0 && p6 = 1 && p7 = 0 && p8 = 0 && p9 < 0 -> inf
  [] p1 = 0 && p10 = 0 && p11 = 0 && p2 = 0 && p3 = 0 && p6 = 1 && p7 = 0 && p8 = 0 && p9 > 0 -> inf

