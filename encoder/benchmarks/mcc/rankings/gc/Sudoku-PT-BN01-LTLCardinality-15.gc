// MCC instance Sudoku-PT-BN01
// 5 places, 1 transitions
// places: p0=Rows_0_0, p1=Board_0_0_0, p2=Regions_0_0, p3=Cells_0_0, p4=Columns_0_0

init: p0 == 1 && p1 == 0 && p2 == 1 && p3 == 1 && p4 == 1

// select_0_0_0_0
[] p3 >= 1 && p4 >= 1 && p2 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p2 = p2 - 1; p3 = p3 - 1; p4 = p4 - 1
// deadlock: stutter (MCC semantics)
[] p4 <= 0 -> p0 = p0

// Sudoku-PT-BN01-LTLCardinality-15
// ap a0 := p2 <= p3
// ap a1 := 3 <= p3
// ap a2 := 1 <= p2
// spec: "G((a0 | G(((a1) U (X(!(X(X(a2)))))))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans(q0, q0): p2 <= p3
trans(q0, q1): p2 > p3 && 3 > p3
trans(q0, q2): p2 > p3
trans(q0, q3): p2 > p3 && 3 <= p3
trans(q1, q4): true
trans(q2, q1): 3 > p3
trans(q2, q2): true
trans(q2, q3): 3 <= p3
trans(q3, q7): 3 > p3
trans(q3, q8): 3 <= p3
trans(q4, q5): true
trans(q5, q6): 1 <= p2
trans!(q6, q6): true
trans(q7, q9): true
trans(q8, q10): 3 > p3
trans(q8, q11): 3 <= p3
trans(q9, q5): 1 <= p2
trans(q10, q9): 1 <= p2
trans!(q11, q10): 3 > p3 && 1 <= p2
trans!(q11, q11): 3 <= p3 && 1 <= p2

rank(q0):
  [] ((-1 * p0) + p2) = 0 && ((-1 * p0) + p3) = 0 -> 0
  [] ((-1 * p0) + p2) < 0 -> inf
  [] ((-1 * p0) + p2) > 0 -> inf
  [] ((-1 * p0) + p2) = 0 && ((-1 * p0) + p3) < 0 -> inf
  [] ((-1 * p0) + p2) = 0 && ((-1 * p0) + p3) > 0 -> inf

rank(q1):
  [] true -> inf

rank(q2):
  [] true -> inf

rank(q3):
  [] true -> inf

rank(q4):
  [] true -> inf

rank(q7):
  [] true -> inf

rank(q8):
  [] true -> inf

rank(q5):
  [] true -> inf

rank(q6):
  [] true -> inf

rank(q9):
  [] true -> inf

rank(q10):
  [] true -> inf

rank(q11):
  [] true -> inf
