// MCC instance SwimmingPool-PT-03
// 9 places, 7 transitions
// places: p0=Entered, p1=WaitBag, p2=Undress, p3=InBath, p4=Dress, p5=Dressed, p6=Out, p7=Cabins, p8=Bags

init: p0 == 0 && p1 == 0 && p2 == 0 && p3 == 0 && p4 == 0 && p5 == 0 && p6 == 60 && p7 == 30 && p8 == 45

// GetK
[] p7 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p7 = p7 - 1
// GetB
[] p8 >= 1 && p1 >= 1 -> p1 = p1 - 1; p2 = p2 + 1; p8 = p8 - 1
// RelK
[] p2 >= 1 -> p2 = p2 - 1; p3 = p3 + 1; p7 = p7 + 1
// GetK2
[] p7 >= 1 && p3 >= 1 -> p3 = p3 - 1; p4 = p4 + 1; p7 = p7 - 1
// RBag
[] p4 >= 1 -> p4 = p4 - 1; p5 = p5 + 1; p8 = p8 + 1
// RKey
[] p5 >= 1 -> p5 = p5 - 1; p6 = p6 + 1; p7 = p7 + 1
// Enter
[] p6 >= 1 -> p0 = p0 + 1; p6 = p6 - 1

// SwimmingPool-PT-03-LTLCardinality-05
// ap a0 := 2 <= p6
// ap a1 := p2 <= p7
// ap a2 := p5 <= p3
// ap a3 := p8 <= p7
// spec: "(G(!(a0)) | X(!((a1 & G((!(a2) & a3))))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q2
trans!(q0, q0): p5 > p3 && p8 <= p7
trans(q1, q0): p2 <= p7 && p5 > p3 && p8 <= p7
trans(q2, q1): 2 <= p6
trans(q2, q3): 2 > p6
trans(q3, q0): 2 <= p6 && p2 <= p7 && p5 > p3 && p8 <= p7
trans(q3, q4): 2 > p6 && p2 <= p7 && p5 > p3 && p8 <= p7
trans(q4, q0): 2 <= p6 && p5 > p3 && p8 <= p7
trans(q4, q4): 2 > p6 && p5 > p3 && p8 <= p7

