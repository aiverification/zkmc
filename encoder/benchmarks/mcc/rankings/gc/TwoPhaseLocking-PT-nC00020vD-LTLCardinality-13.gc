// MCC instance TwoPhaseLocking-PT-nC00020vD
// 8 places, 6 transitions
// places: p0=resB, p1=haveA, p2=haveA2, p3=resA, p4=haveB, p5=Clients, p6=haveAandB, p7=haveA2andB

init: p0 == 10 && p1 == 0 && p2 == 0 && p3 == 10 && p4 == 0 && p5 == 20 && p6 == 0 && p7 == 0

// relB
[] p7 >= 1 -> p0 = p0 + 1; p2 = p2 + 1; p7 = p7 - 1
// lockB
[] p1 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 - 1; p6 = p6 + 1
// lockA
[] p5 >= 1 && p3 >= 1 -> p1 = p1 + 1; p3 = p3 - 1; p5 = p5 - 1
// relA2
[] p2 >= 1 -> p2 = p2 - 1; p3 = p3 + 1; p5 = p5 + 1
// relA
[] p6 >= 1 -> p3 = p3 + 1; p4 = p4 + 1; p6 = p6 - 1
// lockA2
[] p4 >= 1 && p3 >= 1 -> p3 = p3 - 1; p4 = p4 - 1; p7 = p7 + 1
// deadlock: stutter (MCC semantics)
[] p0 <= 0 && p2 <= 0 && p3 <= 0 && p6 <= 0 && p7 <= 0 -> p0 = p0

// TwoPhaseLocking-PT-nC00020vD-LTLCardinality-13
// ap a0 := 1 <= p6
// ap a1 := 3 <= p7
// ap a2 := 2 <= p4
// spec: "!((X(G(a0)) & ((G(a1)) U (F(X(!(a2)))))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q1
trans!(q0, q0): 1 <= p6
trans(q1, q2): true
trans(q2, q0): 1 <= p6 && 2 > p4
trans(q2, q2): 1 <= p6 && 2 <= p4

rank(q1):
  [] p5 = 20 && p0 = 10 && p2 = 0 && p4 = 0 && (p1 + p5) = 20 && p6 = 0 && p7 = 0 -> 0
  [] p5 < 20 -> inf
  [] p5 > 20 -> inf
  [] p5 = 20 && p0 < 10 -> inf
  [] p5 = 20 && p0 > 10 -> inf
  [] p5 = 20 && p0 = 10 && p2 < 0 -> inf
  [] p5 = 20 && p0 = 10 && p2 > 0 -> inf
  [] p5 = 20 && p0 = 10 && p2 = 0 && p4 < 0 -> inf
  [] p5 = 20 && p0 = 10 && p2 = 0 && p4 > 0 -> inf
  [] p5 = 20 && p0 = 10 && p2 = 0 && p4 = 0 && (p1 + p5) < 20 -> inf
  [] p5 = 20 && p0 = 10 && p2 = 0 && p4 = 0 && (p1 + p5) > 20 -> inf
  [] p5 = 20 && p0 = 10 && p2 = 0 && p4 = 0 && (p1 + p5) = 20 && p6 < 0 -> inf
  [] p5 = 20 && p0 = 10 && p2 = 0 && p4 = 0 && (p1 + p5) = 20 && p6 > 0 -> inf
  [] p5 = 20 && p0 = 10 && p2 = 0 && p4 = 0 && (p1 + p5) = 20 && p6 = 0 && p7 < 0 -> inf
  [] p5 = 20 && p0 = 10 && p2 = 0 && p4 = 0 && (p1 + p5) = 20 && p6 = 0 && p7 > 0 -> inf

rank(q0):
  [] true -> inf

rank(q2):
  [] p2 = 0 && p4 = 0 && p6 = 0 -> 0
  [] p2 < 0 -> inf
  [] p2 > 0 -> inf
  [] p2 = 0 && p4 < 0 -> inf
  [] p2 = 0 && p4 > 0 -> inf
  [] p2 = 0 && p4 = 0 && p6 < 0 -> inf
  [] p2 = 0 && p4 = 0 && p6 > 0 -> inf
