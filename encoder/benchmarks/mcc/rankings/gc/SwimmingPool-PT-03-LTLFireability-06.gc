// RelK
[] p2 >= 1 -> p2 = p2 - 1; p3 = p3 + 1; p7 = p7 + 1
// GetK2
[] p7 >= 1 && p3 >= 1 -> p3 = p3 - 1; p4 = p4 + 1; p7 = p7 - 1
// RBag
[] p4 >= 1 -> p4 = p4 - 1; p5 = p5 + 1; p8 = p8 + 1
// RKey
[] p5 >= 1 -> p5 = p5 - 1; p6 = p6 + 1; p7 = p7 + 1
// Enter
[] p6 >= 1 -> p0 = p0 + 1; p6 = p6 - 1

// SwimmingPool-PT-03-LTLFireability-06
