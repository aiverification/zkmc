  [] p5 = 500 && p0 = 250 && p2 = 0 && p4 = 0 && (p1 + p5) = 500 && p6 < 0 -> inf
  [] p5 = 500 && p0 = 250 && p2 = 0 && p4 = 0 && (p1 + p5) = 500 && p6 > 0 -> inf
  [] p5 = 500 && p0 = 250 && p2 = 0 && p4 = 0 && (p1 + p5) = 500 && p6 = 0 && p7 < 0 -> inf
  [] p5 = 500 && p0 = 250 && p2 = 0 && p4 = 0 && (p1 + p5) = 500 && p6 = 0 && p7 > 0 -> inf

rank(q1):
