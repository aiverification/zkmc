  [] p1 <= 1 && p2 >= 0 && p9 <= 1 && (p0 + p1) = 1 && p4 = 0 && p6 = 0 && p7 = 1 && ((p2 + p3) + p8) < 1 -> inf
  [] p1 <= 1 && p2 >= 0 && p9 <= 1 && (p0 + p1) = 1 && p4 = 0 && p6 = 0 && p7 = 1 && ((p2 + p3) + p8) > 1 -> inf
  [] p1 <= 1 && p2 >= 0 && p9 <= 1 && (p0 + p1) = 1 && p4 = 0 && p6 = 0 && p7 = 1 && ((p2 + p3) + p8) = 1 && (((-1 * p2) + (-1 * p3)) + p9) < 0 -> inf
  [] p1 <= 1 && p2 >= 0 && p9 <= 1 && (p0 + p1) = 1 && p4 = 0 && p6 = 0 && p7 = 1 && ((p2 + p3) + p8) = 1 && (((-1 * p2) + (-1 * p3)) + p9) > 0 -> inf

