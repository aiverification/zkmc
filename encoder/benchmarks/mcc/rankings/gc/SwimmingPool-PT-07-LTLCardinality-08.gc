// MCC instance SwimmingPool-PT-07
// 9 places, 7 transitions
// places: p0=Entered, p1=WaitBag, p2=Undress, p3=InBath, p4=Dress, p5=Dressed, p6=Out, p7=Cabins, p8=Bags

init: p0 == 0 && p1 == 0 && p2 == 0 && p3 == 0 && p4 == 0 && p5 == 0 && p6 == 140 && p7 == 70 && p8 == 105

// GetK
[] p7 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p7 = p7 - 1
// GetB
[] p8 >= 1 && p1 >= 1 -> p1 = p1 - 1; p2 = p2 + 1; p8 = p8 - 1
// RelK
[] p2 >= 1 -> p2 = p2 - 1; p3 = p3 + 1; p7 = p7 + 1
// GetK2
[] p7 >= 1 && p3 >= 1 -> p3 = p3 - 1; p4 = p4 + 1; p7 = p7 - 1
// RBag
[] p4 >= 1 -> p4 = p4 - 1; p5 = p5 + 1; p8 = p8 + 1
// RKey
[] p5 >= 1 -> p5 = p5 - 1; p6 = p6 + 1; p7 = p7 + 1
// Enter
[] p6 >= 1 -> p0 = p0 + 1; p6 = p6 - 1

// SwimmingPool-PT-07-LTLCardinality-08
// ap a0 := 2 <= p1
// ap a1 := p0 <= p7
// ap a2 := 1 <= p8
// spec: "(!(a0) | a1 | G((a0 & (a1 | a2))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q1
trans!(q0, q0): true
trans(q1, q0): p0 > p7 && 1 > p8 && 2 <= p1
trans(q1, q2): p0 > p7 && 1 <= p8 && 2 <= p1
trans(q2, q0): p0 > p7 && 1 > p8
trans(q2, q0): 2 > p1
trans(q2, q2): p0 <= p7 && 2 <= p1
trans(q2, q2): 1 <= p8 && 2 <= p1

