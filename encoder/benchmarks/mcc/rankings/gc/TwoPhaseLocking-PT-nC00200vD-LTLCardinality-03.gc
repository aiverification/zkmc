// MCC instance TwoPhaseLocking-PT-nC00200vD
// 8 places, 6 transitions
// places: p0=resB, p1=haveA, p2=haveA2, p3=resA, p4=haveB, p5=Clients, p6=haveAandB, p7=haveA2andB

init: p0 == 100 && p1 == 0 && p2 == 0 && p3 == 100 && p4 == 0 && p5 == 200 && p6 == 0 && p7 == 0

// relB
[] p7 >= 1 -> p0 = p0 + 1; p2 = p2 + 1; p7 = p7 - 1
// lockB
[] p1 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 - 1; p6 = p6 + 1
// lockA
[] p5 >= 1 && p3 >= 1 -> p1 = p1 + 1; p3 = p3 - 1; p5 = p5 - 1
// relA2
[] p2 >= 1 -> p2 = p2 - 1; p3 = p3 + 1; p5 = p5 + 1
// relA
[] p6 >= 1 -> p3 = p3 + 1; p4 = p4 + 1; p6 = p6 - 1
// lockA2
[] p4 >= 1 && p3 >= 1 -> p3 = p3 - 1; p4 = p4 - 1; p7 = p7 + 1
// deadlock: stutter (MCC semantics)
[] p0 <= 0 && p2 <= 0 && p3 <= 0 && p6 <= 0 && p7 <= 0 -> p0 = p0

// TwoPhaseLocking-PT-nC00200vD-LTLCardinality-03
// ap a0 := p3 <= p6
// ap a1 := p6 <= p4
// ap a2 := p1 <= p3
// spec: "(!(a0) & X(((G(!(a1))) U (a2))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans(q0, q1): p3 <= p6
trans(q0, q2): p3 > p6
trans!(q1, q1): true
trans!(q2, q1): p1 > p3 && p6 <= p4
trans!(q2, q2): p1 > p3 && p6 > p4
trans!(q2, q3): p1 > p3 && p6 > p4
trans(q3, q1): p6 <= p4
trans(q3, q3): p6 > p4

rank(q0):
  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) = 100 && p4 = 0 && (p1 + p5) = 200 && p6 = 0 && p7 = 0 -> 0
  [] p5 < 200 -> inf
  [] p5 > 200 -> inf
  [] p5 = 200 && p0 < 100 -> inf
  [] p5 = 200 && p0 > 100 -> inf
  [] p5 = 200 && p0 = 100 && p2 < 0 -> inf
  [] p5 = 200 && p0 = 100 && p2 > 0 -> inf
  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) < 100 -> inf
  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) > 100 -> inf
  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) = 100 && p4 < 0 -> inf
  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) = 100 && p4 > 0 -> inf
  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) = 100 && p4 = 0 && (p1 + p5) < 200 -> inf
  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) = 100 && p4 = 0 && (p1 + p5) > 200 -> inf
  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) = 100 && p4 = 0 && (p1 + p5) = 200 && p6 < 0 -> inf
  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) = 100 && p4 = 0 && (p1 + p5) = 200 && p6 > 0 -> inf
  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) = 100 && p4 = 0 && (p1 + p5) = 200 && p6 = 0 && p7 < 0 -> inf
  [] p5 = 200 && p0 = 100 && p2 = 0 && (p1 + p3) = 100 && p4 = 0 && (p1 + p5) = 200 && p6 = 0 && p7 > 0 -> inf

rank(q1):
  [] true -> inf

