// MCC instance ResAllocation-PT-R002C002
// 8 places, 6 transitions
// places: p0=p_0_0, p1=r_0_0, p2=p_0_1, p3=r_0_1, p4=p_1_0, p5=r_1_0, p6=p_1_1, p7=r_1_1

init: p0 == 0 && p1 == 1 && p2 == 0 && p3 == 1 && p4 == 0 && p5 == 1 && p6 == 0 && p7 == 1

// t_0_0
[] p1 >= 1 -> p0 = p0 + 1; p1 = p1 - 1
// t_0_1
[] p0 >= 1 && p3 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p2 = p2 + 1; p3 = p3 - 1
// t_0_2
[] p2 >= 1 -> p2 = p2 - 1; p3 = p3 + 1
// t_1_0
[] p4 >= 1 -> p1 = p1 + 1; p4 = p4 - 1; p5 = p5 + 1
// t_1_1
[] p6 >= 1 && p1 >= 1 && p5 >= 1 -> p1 = p1 - 1; p3 = p3 + 1; p4 = p4 + 1; p5 = p5 - 1; p6 = p6 - 1; p7 = p7 + 1
// t_1_2
[] p3 >= 1 && p7 >= 1 -> p3 = p3 - 1; p6 = p6 + 1; p7 = p7 - 1
// deadlock: stutter (MCC semantics)
[] p1 <= 0 && p2 <= 0 && p3 <= 0 && p4 <= 0 -> p0 = p0

// ResAllocation-PT-R002C002-LTLFireability-04
// ap e0 := p6 >= 1 && p1 >= 1 && p5 >= 1
// ap e1 := p2 >= 1
// ap e2 := p1 >= 1
// spec: "G((!(G(((e0) & (!((e1)) | (e0))))) | X(X(F(X((e2)))))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans(q0, q0): true
trans(q0, q1): p6 >= 1 && p1 >= 1 && p5 >= 1
trans(q1, q2): p6 >= 1 && p1 >= 1 && p5 >= 1
trans(q2, q3): p6 >= 1 && p1 >= 1 && p5 >= 1
trans!(q3, q3): p6 >= 1 && p1 >= 1 && p5 >= 1 && p1 < 1

rank(q0):
  [] ((p0 + p1) + p4) = 1 && (((-1 * p0) + (-1 * p1)) + p5) = 0 && ((p2 + p3) + p6) = 1 && p0 >= 0 && p2 >= 0 && p3 >= 0 && p5 <= 1 -> 0
  [] ((p0 + p1) + p4) < 1 -> inf
  [] ((p0 + p1) + p4) > 1 -> inf
  [] ((p0 + p1) + p4) = 1 && (((-1 * p0) + (-1 * p1)) + p5) < 0 -> inf
  [] ((p0 + p1) + p4) = 1 && (((-1 * p0) + (-1 * p1)) + p5) > 0 -> inf
  [] ((p0 + p1) + p4) = 1 && (((-1 * p0) + (-1 * p1)) + p5) = 0 && ((p2 + p3) + p6) < 1 -> inf
  [] ((p0 + p1) + p4) = 1 && (((-1 * p0) + (-1 * p1)) + p5) = 0 && ((p2 + p3) + p6) > 1 -> inf
  [] ((p0 + p1) + p4) = 1 && (((-1 * p0) + (-1 * p1)) + p5) = 0 && ((p2 + p3) + p6) = 1 && p0 < 0 -> inf
  [] ((p0 + p1) + p4) = 1 && (((-1 * p0) + (-1 * p1)) + p5) = 0 && ((p2 + p3) + p6) = 1 && p0 >= 0 && p2 < 0 -> inf
  [] ((p0 + p1) + p4) = 1 && (((-1 * p0) + (-1 * p1)) + p5) = 0 && ((p2 + p3) + p6) = 1 && p0 >= 0 && p2 >= 0 && p3 < 0 -> inf
  [] ((p0 + p1) + p4) = 1 && (((-1 * p0) + (-1 * p1)) + p5) = 0 && ((p2 + p3) + p6) = 1 && p0 >= 0 && p2 >= 0 && p3 >= 0 && p5 > 1 -> inf

rank(q1):
  [] p1 = 0 -> 0
  [] p1 < 0 -> inf
  [] p1 > 0 -> inf

rank(q2):
  [] true -> inf

rank(q3):
  [] true -> inf
