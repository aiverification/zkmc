// MCC instance Sudoku-PT-AN01
// 4 places, 1 transitions
// places: p0=Rows_0_0, p1=Board_0_0_0, p2=Cells_0_0, p3=Columns_0_0

init: p0 == 1 && p1 == 0 && p2 == 1 && p3 == 1

// select_0_0_0
[] p2 >= 1 && p3 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p2 = p2 - 1; p3 = p3 - 1
// deadlock: stutter (MCC semantics)
[] p3 <= 0 -> p0 = p0

// Sudoku-PT-AN01-LTLCardinality-02
// ap a0 := 3 <= p2
// ap a1 := 1 <= p2
// ap a2 := p2 <= p3
// spec: "(!(X(a0)) & G((a1 | a0 | X(X(a2)))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans(q0, q1): true
trans(q0, q2): 1 > p2 && 3 > p2
trans(q0, q3): true
trans(q1, q4): 3 <= p2
trans(q2, q5): true
trans(q3, q2): 1 > p2 && 3 > p2
trans(q3, q3): true
trans!(q4, q4): true
trans(q5, q4): p2 > p3

rank(q0):
  [] p0 = 1 && p2 = 1 && p3 = 1 -> 0
  [] p0 < 1 -> inf
  [] p0 > 1 -> inf
  [] p0 = 1 && p2 < 1 -> inf
  [] p0 = 1 && p2 > 1 -> inf
  [] p0 = 1 && p2 = 1 && p3 < 1 -> inf
  [] p0 = 1 && p2 = 1 && p3 > 1 -> inf

rank(q1):
  [] p0 = 0 && p2 = 0 -> 0
  [] p0 < 0 -> inf
  [] p0 > 0 -> inf
  [] p0 = 0 && p2 < 0 -> inf
  [] p0 = 0 && p2 > 0 -> inf

rank(q2):
  [] p0 = 0 && p2 = 0 && p3 = 0 -> 0
  [] p0 < 0 -> inf
  [] p0 > 0 -> inf
  [] p0 = 0 && p2 < 0 -> inf
  [] p0 = 0 && p2 > 0 -> inf
  [] p0 = 0 && p2 = 0 && p3 < 0 -> inf
  [] p0 = 0 && p2 = 0 && p3 > 0 -> inf

rank(q3):
  [] p0 = 0 && p2 = 0 && p3 = 0 -> 0
  [] p0 < 0 -> inf
  [] p0 > 0 -> inf
  [] p0 = 0 && p2 < 0 -> inf
  [] p0 = 0 && p2 > 0 -> inf
  [] p0 = 0 && p2 = 0 && p3 < 0 -> inf
  [] p0 = 0 && p2 = 0 && p3 > 0 -> inf

rank(q4):
  [] true -> inf

rank(q5):
  [] p0 = 0 && p2 = 0 && p3 = 0 -> 0
  [] p0 < 0 -> inf
  [] p0 > 0 -> inf
  [] p0 = 0 && p2 < 0 -> inf
  [] p0 = 0 && p2 > 0 -> inf
  [] p0 = 0 && p2 = 0 && p3 < 0 -> inf
  [] p0 = 0 && p2 = 0 && p3 > 0 -> inf
