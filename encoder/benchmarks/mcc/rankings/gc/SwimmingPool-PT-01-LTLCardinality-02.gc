// MCC instance SwimmingPool-PT-01
// 9 places, 7 transitions
// places: p0=Entered, p1=WaitBag, p2=Undress, p3=InBath, p4=Dress, p5=Dressed, p6=Out, p7=Cabins, p8=Bags

init: p0 == 0 && p1 == 0 && p2 == 0 && p3 == 0 && p4 == 0 && p5 == 0 && p6 == 20 && p7 == 10 && p8 == 15

// GetK
[] p7 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p7 = p7 - 1
// GetB
[] p8 >= 1 && p1 >= 1 -> p1 = p1 - 1; p2 = p2 + 1; p8 = p8 - 1
// RelK
[] p2 >= 1 -> p2 = p2 - 1; p3 = p3 + 1; p7 = p7 + 1
// GetK2
[] p7 >= 1 && p3 >= 1 -> p3 = p3 - 1; p4 = p4 + 1; p7 = p7 - 1
// RBag
[] p4 >= 1 -> p4 = p4 - 1; p5 = p5 + 1; p8 = p8 + 1
// RKey
[] p5 >= 1 -> p5 = p5 - 1; p6 = p6 + 1; p7 = p7 + 1
// Enter
[] p6 >= 1 -> p0 = p0 + 1; p6 = p6 - 1

// SwimmingPool-PT-01-LTLCardinality-02
// ap a0 := 2 <= p2
// ap a1 := p6 <= p0
// ap a2 := p3 <= p5
// spec: "(X(X(X(a0))) | ((X((!(a1) | a2))) U (a2)))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q4
trans(q0, q2): 2 > p2
trans(q1, q2): p6 <= p0 && p3 > p5 && 2 > p2
trans(q1, q7): p6 > p0 && p3 > p5 && 2 > p2
trans!(q2, q2): true
trans(q3, q0): true
trans(q4, q5): p3 > p5
trans(q5, q3): p6 <= p0 && p3 > p5
trans(q5, q6): p6 > p0 && p3 > p5
trans(q6, q0): p6 <= p0 && p3 > p5
trans(q6, q1): p6 > p0 && p3 > p5
trans!(q7, q2): p6 <= p0 && p3 > p5
trans!(q7, q7): p6 > p0 && p3 > p5

rank(q4):
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 20 && ((((p1 + p2) + p4) + p5) + p7) = 10 && (((p2 + p3) + p4) + p8) = 15 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p0 < 1 && p1 < 1 && p2 < 1 && p4 < 1 && p5 < 1 && p3 <= p5 -> 0
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) < 20 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) > 20 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 20 && ((((p1 + p2) + p4) + p5) + p7) < 10 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 20 && ((((p1 + p2) + p4) + p5) + p7) > 10 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 20 && ((((p1 + p2) + p4) + p5) + p7) = 10 && (((p2 + p3) + p4) + p8) < 15 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 20 && ((((p1 + p2) + p4) + p5) + p7) = 10 && (((p2 + p3) + p4) + p8) > 15 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 20 && ((((p1 + p2) + p4) + p5) + p7) = 10 && (((p2 + p3) + p4) + p8) = 15 && p0 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 20 && ((((p1 + p2) + p4) + p5) + p7) = 10 && (((p2 + p3) + p4) + p8) = 15 && p0 >= 0 && p1 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 20 && ((((p1 + p2) + p4) + p5) + p7) = 10 && (((p2 + p3) + p4) + p8) = 15 && p0 >= 0 && p1 >= 0 && p2 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 20 && ((((p1 + p2) + p4) + p5) + p7) = 10 && (((p2 + p3) + p4) + p8) = 15 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 20 && ((((p1 + p2) + p4) + p5) + p7) = 10 && (((p2 + p3) + p4) + p8) = 15 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 < 0 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 20 && ((((p1 + p2) + p4) + p5) + p7) = 10 && (((p2 + p3) + p4) + p8) = 15 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p0 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 20 && ((((p1 + p2) + p4) + p5) + p7) = 10 && (((p2 + p3) + p4) + p8) = 15 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p0 < 1 && p1 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 20 && ((((p1 + p2) + p4) + p5) + p7) = 10 && (((p2 + p3) + p4) + p8) = 15 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p0 < 1 && p1 < 1 && p2 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 20 && ((((p1 + p2) + p4) + p5) + p7) = 10 && (((p2 + p3) + p4) + p8) = 15 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p0 < 1 && p1 < 1 && p2 < 1 && p4 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 20 && ((((p1 + p2) + p4) + p5) + p7) = 10 && (((p2 + p3) + p4) + p8) = 15 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p0 < 1 && p1 < 1 && p2 < 1 && p4 < 1 && p5 >= 1 -> inf
  [] ((((((p0 + p1) + p2) + p3) + p4) + p5) + p6) = 20 && ((((p1 + p2) + p4) + p5) + p7) = 10 && (((p2 + p3) + p4) + p8) = 15 && p0 >= 0 && p1 >= 0 && p2 >= 0 && p3 >= 0 && p4 >= 0 && p0 < 1 && p1 < 1 && p2 < 1 && p4 < 1 && p5 < 1 && p3 > p5 -> inf

rank(q0):
  [] true -> inf

