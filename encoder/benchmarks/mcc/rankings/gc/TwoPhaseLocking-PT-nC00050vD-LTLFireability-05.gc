// MCC instance TwoPhaseLocking-PT-nC00050vD
// 8 places, 6 transitions
// places: p0=resB, p1=haveA, p2=haveA2, p3=resA, p4=haveB, p5=Clients, p6=haveAandB, p7=haveA2andB

init: p0 == 25 && p1 == 0 && p2 == 0 && p3 == 25 && p4 == 0 && p5 == 50 && p6 == 0 && p7 == 0

// relB
[] p7 >= 1 -> p0 = p0 + 1; p2 = p2 + 1; p7 = p7 - 1
// lockB
[] p1 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 - 1; p6 = p6 + 1
// lockA
[] p5 >= 1 && p3 >= 1 -> p1 = p1 + 1; p3 = p3 - 1; p5 = p5 - 1
// relA2
[] p2 >= 1 -> p2 = p2 - 1; p3 = p3 + 1; p5 = p5 + 1
// relA
[] p6 >= 1 -> p3 = p3 + 1; p4 = p4 + 1; p6 = p6 - 1
// lockA2
[] p4 >= 1 && p3 >= 1 -> p3 = p3 - 1; p4 = p4 - 1; p7 = p7 + 1
// deadlock: stutter (MCC semantics)
[] p0 <= 0 && p2 <= 0 && p3 <= 0 && p6 <= 0 && p7 <= 0 -> p0 = p0

// TwoPhaseLocking-PT-nC00050vD-LTLFireability-05
// ap e0 := p1 >= 1 && p0 >= 1
// ap e1 := p5 >= 1 && p3 >= 1
// spec: "(!((e0)) | G(((X((e0))) U (X(X(!(X(X((e1))))))))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans(q0, q1): p1 >= 1 && p0 >= 1
trans(q1, q1): true
trans(q1, q2): p1 < 1
trans(q1, q2): p0 < 1
trans(q1, q3): p1 >= 1 && p0 >= 1
trans(q2, q4): true
trans(q3, q7): p1 < 1
trans(q3, q7): p0 < 1
trans(q3, q8): p1 >= 1 && p0 >= 1
trans(q4, q5): true
trans(q5, q6): p5 >= 1 && p3 >= 1
trans!(q6, q6): true
trans(q7, q9): true
trans(q8, q10): p1 < 1
trans(q8, q10): p0 < 1
trans(q8, q11): p1 >= 1 && p0 >= 1
trans(q9, q5): p5 >= 1 && p3 >= 1
trans(q10, q9): p5 >= 1 && p3 >= 1
trans!(q11, q10): p1 < 1 && p5 >= 1 && p3 >= 1
trans!(q11, q10): p0 < 1 && p5 >= 1 && p3 >= 1
trans!(q11, q11): p1 >= 1 && p0 >= 1 && p5 >= 1 && p3 >= 1

rank(q0):
  [] p1 = 0 -> 0
  [] p1 < 0 -> inf
  [] p1 > 0 -> inf

rank(q1):
  [] true -> inf

rank(q2):
  [] true -> inf

rank(q3):
  [] true -> inf

rank(q4):
  [] true -> inf

rank(q7):
  [] true -> inf

rank(q8):
  [] true -> inf

rank(q5):
  [] true -> inf

rank(q6):
  [] true -> inf

rank(q9):
  [] true -> inf

rank(q10):
