// MCC instance CryptoMiner-PT-D05N000
// 12 places, 12 transitions
// places: p0=resource_c0, p1=resource_c1, p2=resource_c2, p3=resource_c3, p4=resource_c4, p5=resource_c5, p6=state_c0, p7=state_c1, p8=state_c2, p9=state_c3, p10=state_c4, p11=state_c5

init: p0 == 0 && p1 == 0 && p2 == 0 && p3 == 0 && p4 == 0 && p5 == 0 && p6 == 1 && p7 == 0 && p8 == 0 && p9 == 0 && p10 == 0 && p11 == 0

// Compute_0
[] p1 >= 1 && p7 >= 1 -> p1 = p1 - 1; p2 = p2 + 1
// Compute_1
[] p2 >= 1 && p8 >= 1 -> p2 = p2 - 1; p3 = p3 + 1
// Compute_2
[] p3 >= 1 && p9 >= 1 -> p3 = p3 - 1; p4 = p4 + 1
// Compute_3
[] p4 >= 1 && p10 >= 1 -> p4 = p4 - 1; p5 = p5 + 1
// Compute_4
[] p5 >= 1 && p11 >= 1 -> p0 = p0 + 1; p5 = p5 - 1
// ComputeFirst_5
[] p6 >= 1 -> p1 = p1 + 1
// Exit_6
[] p11 >= 1 -> p11 = p11 - 1
// Go_7
[] p6 >= 1 -> p6 = p6 - 1; p7 = p7 + 1
// Go_8
[] p7 >= 1 -> p7 = p7 - 1; p8 = p8 + 1
// Go_9
[] p8 >= 1 -> p8 = p8 - 1; p9 = p9 + 1
// Go_10
[] p9 >= 1 -> p9 = p9 - 1; p10 = p10 + 1
// Go_11
[] p10 >= 1 -> p10 = p10 - 1; p11 = p11 + 1
// deadlock: stutter (MCC semantics)
[] p6 <= 0 && p7 <= 0 && p8 <= 0 && p9 <= 0 && p10 <= 0 && p11 <= 0 -> p0 = p0

// CryptoMiner-PT-D05N000-LTLFireability-14
// ap e0 := p6 >= 1
// ap e1 := p7 >= 1
// spec: "((e0) | ((!(X(X(((!((e0))) U ((e1))))))) U (((e0) | !(F((e0)))))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q2
trans!(q0, q0): true
trans(q1, q3): p6 < 1
trans(q1, q4): p6 >= 1
trans(q2, q1): p6 < 1
trans(q3, q0): p6 >= 1 && p7 >= 1
trans(q3, q3): p6 < 1 && p7 < 1
trans(q3, q4): p6 >= 1 && p7 < 1
trans(q3, q5): p6 < 1 && p7 >= 1
trans(q4, q0): p7 >= 1
trans(q4, q4): p6 < 1 && p7 < 1
trans(q5, q0): p6 >= 1
trans(q5, q5): p6 < 1

rank(q2):
  [] p1 = 0 && p10 = 0 && p11 = 0 && p2 = 0 && p3 = 0 && p6 = 1 -> 0
  [] p1 < 0 -> inf
  [] p1 > 0 -> inf
  [] p1 = 0 && p10 < 0 -> inf
  [] p1 = 0 && p10 > 0 -> inf
  [] p1 = 0 && p10 = 0 && p11 < 0 -> inf
  [] p1 = 0 && p10 = 0 && p11 > 0 -> inf
  [] p1 = 0 && p10 = 0 && p11 = 0 && p2 < 0 -> inf
  [] p1 = 0 && p10 = 0 && p11 = 0 && p2 > 0 -> inf
  [] p1 = 0 && p10 = 0 && p11 = 0 && p2 = 0 && p3 < 0 -> inf
  [] p1 = 0 && p10 = 0 && p11 = 0 && p2 = 0 && p3 > 0 -> inf
  [] p1 = 0 && p10 = 0 && p11 = 0 && p2 = 0 && p3 = 0 && p6 < 1 -> inf
  [] p1 = 0 && p10 = 0 && p11 = 0 && p2 = 0 && p3 = 0 && p6 > 1 -> inf

rank(q0):
  [] true -> inf

rank(q1):
  [] true -> inf

rank(q3):
  [] true -> inf

rank(q4):
  [] true -> inf

rank(q5):
  [] true -> inf
