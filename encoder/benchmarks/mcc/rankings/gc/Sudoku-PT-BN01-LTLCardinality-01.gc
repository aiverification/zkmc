// MCC instance Sudoku-PT-BN01
// 5 places, 1 transitions
// places: p0=Rows_0_0, p1=Board_0_0_0, p2=Regions_0_0, p3=Cells_0_0, p4=Columns_0_0

init: p0 == 1 && p1 == 0 && p2 == 1 && p3 == 1 && p4 == 1

// select_0_0_0_0
[] p3 >= 1 && p4 >= 1 && p2 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p2 = p2 - 1; p3 = p3 - 1; p4 = p4 - 1
// deadlock: stutter (MCC semantics)
[] p4 <= 0 -> p0 = p0

// Sudoku-PT-BN01-LTLCardinality-01
// ap a0 := 3 <= p2
// ap a1 := 1 <= p1
// ap a2 := 3 <= p4
// ap a3 := p4 <= p3
// spec: "X((a0 | (((((F(a1)) U (a2))) U (G(a3))) & X(X(X(a1))))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans(q0, q1): true
trans(q1, q2): 3 > p2 && p4 > p3 && 3 > p4 && 1 > p1
trans(q1, q3): 3 > p2 && p4 > p3 && 3 > p4
trans(q1, q4): 3 > p2
trans(q1, q5): 3 > p2
trans(q1, q6): 3 > p2 && p4 <= p3 && 3 > p4 && 1 > p1
trans!(q2, q2): 1 > p1
trans!(q3, q2): 3 > p4 && 1 > p1
trans!(q3, q3): 3 > p4
trans!(q4, q2): p4 > p3 && 3 > p4 && 1 > p1
trans!(q4, q3): p4 > p3 && 3 > p4
trans!(q4, q4): p4 > p3
trans!(q4, q6): p4 <= p3 && 3 > p4 && 1 > p1
trans!(q4, q7): p4 <= p3
trans(q5, q8): true
trans(q6, q2): p4 > p3 && 3 <= p4 && 1 > p1
trans(q6, q6): p4 <= p3 && 3 <= p4 && 1 > p1
trans(q7, q2): p4 > p3 && 3 > p4 && 1 > p1
trans(q7, q3): p4 > p3 && 3 > p4
trans(q7, q4): p4 > p3
trans(q7, q6): p4 <= p3 && 3 > p4 && 1 > p1
trans(q7, q7): p4 <= p3
trans(q8, q9): true
trans(q9, q10): 1 > p1
trans!(q10, q10): true

rank(q0):
  [] p0 = 1 && p1 = 0 && p3 = 1 && p4 = 1 -> 1
  [] p0 < 1 -> inf
  [] p0 > 1 -> inf
  [] p0 = 1 && p1 < 0 -> inf
  [] p0 = 1 && p1 > 0 -> inf
  [] p0 = 1 && p1 = 0 && p3 < 1 -> inf
  [] p0 = 1 && p1 = 0 && p3 > 1 -> inf
  [] p0 = 1 && p1 = 0 && p3 = 1 && p4 < 1 -> inf
  [] p0 = 1 && p1 = 0 && p3 = 1 && p4 > 1 -> inf

rank(q1):
  [] p0 = 0 && p1 = 1 && p3 = 0 -> 1
  [] p0 < 0 -> inf
  [] p0 > 0 -> inf
  [] p0 = 0 && p1 < 1 -> inf
  [] p0 = 0 && p1 > 1 -> inf
  [] p0 = 0 && p1 = 1 && p3 < 0 -> inf
  [] p0 = 0 && p1 = 1 && p3 > 0 -> inf

rank(q2):
  [] true -> inf

rank(q3):
  [] true -> inf

