  [] p0 = 0 && p1 < 1 -> inf
  [] p0 = 0 && p1 > 1 -> inf
  [] p0 = 0 && p1 = 1 && p3 < 0 -> inf
  [] p0 = 0 && p1 = 1 && p3 > 0 -> inf

