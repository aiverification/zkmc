// Sudoku-PT-AN02-LTLCardinality-11
// ap a0 := p17 <= p2
// ap a1 := 1 <= p13
// ap a2 := p1 <= p13
// spec: "(!(F(X(!(a0)))) | ((a0) U ((a1 & a2))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q1
trans!(q0, q0): true
trans(q1, q2): 1 > p13 && p17 > p2
trans(q1, q2): p17 > p2 && p1 > p13
trans(q1, q3): 1 > p13 && p17 <= p2
trans(q1, q3): p17 <= p2 && p1 > p13
trans(q2, q0): p17 > p2
trans(q2, q2): p17 <= p2
trans(q3, q0): 1 > p13 && p17 > p2
trans(q3, q0): p17 > p2 && p1 > p13
trans(q3, q3): 1 > p13 && p17 <= p2
trans(q3, q3): p17 <= p2 && p1 > p13

rank(q1):
