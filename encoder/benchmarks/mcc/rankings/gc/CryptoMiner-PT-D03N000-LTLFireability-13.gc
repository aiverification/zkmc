// MCC instance CryptoMiner-PT-D03N000
// 8 places, 8 transitions
// places: p0=resource_c0, p1=resource_c1, p2=resource_c2, p3=resource_c3, p4=state_c0, p5=state_c1, p6=state_c2, p7=state_c3

init: p0 == 0 && p1 == 0 && p2 == 0 && p3 == 0 && p4 == 1 && p5 == 0 && p6 == 0 && p7 == 0

// Compute_0
[] p1 >= 1 && p5 >= 1 -> p1 = p1 - 1; p2 = p2 + 1
// Compute_1
[] p2 >= 1 && p6 >= 1 -> p2 = p2 - 1; p3 = p3 + 1
// Compute_2
[] p3 >= 1 && p7 >= 1 -> p0 = p0 + 1; p3 = p3 - 1
// ComputeFirst_3
[] p4 >= 1 -> p1 = p1 + 1
// Exit_4
[] p7 >= 1 -> p7 = p7 - 1
// Go_5
[] p4 >= 1 -> p4 = p4 - 1; p5 = p5 + 1
// Go_6
[] p5 >= 1 -> p5 = p5 - 1; p6 = p6 + 1
// Go_7
[] p6 >= 1 -> p6 = p6 - 1; p7 = p7 + 1
// deadlock: stutter (MCC semantics)
[] p4 <= 0 && p5 <= 0 && p6 <= 0 && p7 <= 0 -> p0 = p0

// CryptoMiner-PT-D03N000-LTLFireability-13
// ap e0 := p4 >= 1
// ap e1 := p7 >= 1
// spec: "!(X(G(X(X(((e0) & X((e0)) & X(((e1) | !((e0))))))))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q4
trans(q0, q1): p4 >= 1
trans!(q1, q1): p7 >= 1 && p4 >= 1
trans(q2, q0): true
trans(q3, q2): true
trans(q4, q3): true

rank(q4):
  [] p1 = 0 && p2 = 0 && p5 = 0 && p6 = 0 && p7 = 0 && (((p4 + p5) + p6) + p7) = 1 -> 0
  [] p1 < 0 -> inf
  [] p1 > 0 -> inf
  [] p1 = 0 && p2 < 0 -> inf
  [] p1 = 0 && p2 > 0 -> inf
  [] p1 = 0 && p2 = 0 && p5 < 0 -> inf
  [] p1 = 0 && p2 = 0 && p5 > 0 -> inf
  [] p1 = 0 && p2 = 0 && p5 = 0 && p6 < 0 -> inf
  [] p1 = 0 && p2 = 0 && p5 = 0 && p6 > 0 -> inf
  [] p1 = 0 && p2 = 0 && p5 = 0 && p6 = 0 && p7 < 0 -> inf
  [] p1 = 0 && p2 = 0 && p5 = 0 && p6 = 0 && p7 > 0 -> inf
  [] p1 = 0 && p2 = 0 && p5 = 0 && p6 = 0 && p7 = 0 && (((p4 + p5) + p6) + p7) < 1 -> inf
  [] p1 = 0 && p2 = 0 && p5 = 0 && p6 = 0 && p7 = 0 && (((p4 + p5) + p6) + p7) > 1 -> inf

rank(q0):
  [] p5 >= 0 && p6 >= 0 && p7 >= 0 && (((p4 + p5) + p6) + p7) = 1 -> 0
  [] p5 < 0 -> inf
  [] p5 >= 0 && p6 < 0 -> inf
  [] p5 >= 0 && p6 >= 0 && p7 < 0 -> inf
  [] p5 >= 0 && p6 >= 0 && p7 >= 0 && (((p4 + p5) + p6) + p7) < 1 -> inf
  [] p5 >= 0 && p6 >= 0 && p7 >= 0 && (((p4 + p5) + p6) + p7) > 1 -> inf

rank(q1):
  [] p6 = 0 && p7 = 0 -> 0
  [] p6 < 0 -> inf
  [] p6 > 0 -> inf
  [] p6 = 0 && p7 < 0 -> inf
  [] p6 = 0 && p7 > 0 -> inf

rank(q2):
  [] p5 >= 0 && p6 >= 0 && p7 = 0 && (((p4 + p5) + p6) + p7) = 1 -> 0
  [] p5 < 0 -> inf
  [] p5 >= 0 && p6 < 0 -> inf
  [] p5 >= 0 && p6 >= 0 && p7 < 0 -> inf
  [] p5 >= 0 && p6 >= 0 && p7 > 0 -> inf
  [] p5 >= 0 && p6 >= 0 && p7 = 0 && (((p4 + p5) + p6) + p7) < 1 -> inf
  [] p5 >= 0 && p6 >= 0 && p7 = 0 && (((p4 + p5) + p6) + p7) > 1 -> inf

rank(q3):
  [] p2 = 0 && p5 >= 0 && p6 = 0 && p7 = 0 && (((p4 + p5) + p6) + p7) = 1 -> 0
  [] p2 < 0 -> inf
  [] p2 > 0 -> inf
  [] p2 = 0 && p5 < 0 -> inf
  [] p2 = 0 && p5 >= 0 && p6 < 0 -> inf
  [] p2 = 0 && p5 >= 0 && p6 > 0 -> inf
  [] p2 = 0 && p5 >= 0 && p6 = 0 && p7 < 0 -> inf
  [] p2 = 0 && p5 >= 0 && p6 = 0 && p7 > 0 -> inf
  [] p2 = 0 && p5 >= 0 && p6 = 0 && p7 = 0 && (((p4 + p5) + p6) + p7) < 1 -> inf
  [] p2 = 0 && p5 >= 0 && p6 = 0 && p7 = 0 && (((p4 + p5) + p6) + p7) > 1 -> inf
