trans(q0, q0): true
trans(q0, q1): p7 >= 1 && p0 >= 1 && p5 < 1
trans!(q1, q1): p7 >= 1 && p0 >= 1 && p5 < 1
trans!(q1, q2): p7 < 1 && p5 < 1
trans!(q1, q2): p0 < 1 && p5 < 1
trans(q2, q1): p7 >= 1 && p0 >= 1 && p5 < 1
trans(q2, q2): p7 < 1 && p5 < 1
trans(q2, q2): p0 < 1 && p5 < 1

