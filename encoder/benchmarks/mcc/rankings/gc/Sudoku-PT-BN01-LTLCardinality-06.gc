// MCC instance Sudoku-PT-BN01
// 5 places, 1 transitions
// places: p0=Rows_0_0, p1=Board_0_0_0, p2=Regions_0_0, p3=Cells_0_0, p4=Columns_0_0

init: p0 == 1 && p1 == 0 && p2 == 1 && p3 == 1 && p4 == 1

// select_0_0_0_0
[] p3 >= 1 && p4 >= 1 && p2 >= 1 && p0 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p2 = p2 - 1; p3 = p3 - 1; p4 = p4 - 1
// deadlock: stutter (MCC semantics)
[] p4 <= 0 -> p0 = p0

// Sudoku-PT-BN01-LTLCardinality-06
// ap a0 := 1 <= p1
// ap a1 := p2 <= p4
// ap a2 := 1 <= p3
// spec: "!(X(X(!((X(a0) | ((F(a1)) U (a2)))))))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans(q0, q1): true
trans(q1, q2): true
trans(q2, q3): 1 > p3
trans(q2, q4): 1 > p3 && p2 > p4
trans(q3, q5): 1 > p3 && p2 > p4 && 1 > p1
trans(q3, q6): 1 > p3 && 1 > p1
trans(q4, q5): 1 <= p3 && p2 > p4 && 1 > p1
trans!(q5, q5): p2 > p4
trans!(q6, q5): 1 > p3 && p2 > p4
trans!(q6, q6): 1 > p3

rank(q0):
  [] p0 = 1 && p1 = 0 && p2 = 1 && p4 = 1 -> 0
  [] p0 < 1 -> inf
  [] p0 > 1 -> inf
  [] p0 = 1 && p1 < 0 -> inf
  [] p0 = 1 && p1 > 0 -> inf
  [] p0 = 1 && p1 = 0 && p2 < 1 -> inf
  [] p0 = 1 && p1 = 0 && p2 > 1 -> inf
  [] p0 = 1 && p1 = 0 && p2 = 1 && p4 < 1 -> inf
  [] p0 = 1 && p1 = 0 && p2 = 1 && p4 > 1 -> inf

rank(q1):
  [] p0 = 0 && p1 = 1 && p2 = 0 && p4 = 0 -> 0
  [] p0 < 0 -> inf
  [] p0 > 0 -> inf
  [] p0 = 0 && p1 < 1 -> inf
  [] p0 = 0 && p1 > 1 -> inf
  [] p0 = 0 && p1 = 1 && p2 < 0 -> inf
  [] p0 = 0 && p1 = 1 && p2 > 0 -> inf
  [] p0 = 0 && p1 = 1 && p2 = 0 && p4 < 0 -> inf
  [] p0 = 0 && p1 = 1 && p2 = 0 && p4 > 0 -> inf

rank(q2):
  [] p1 = 1 && p2 = 0 && p4 = 0 -> 0
  [] p1 < 1 -> inf
  [] p1 > 1 -> inf
  [] p1 = 1 && p2 < 0 -> inf
  [] p1 = 1 && p2 > 0 -> inf
  [] p1 = 1 && p2 = 0 && p4 < 0 -> inf
  [] p1 = 1 && p2 = 0 && p4 > 0 -> inf

rank(q3):
  [] p1 = 1 -> 0
  [] p1 < 1 -> inf
  [] p1 > 1 -> inf

rank(q4):
  [] true -> inf

rank(q5):
  [] true -> inf

rank(q6):
  [] true -> inf
