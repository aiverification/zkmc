// MCC instance PGCD-PT-D02N100
// 9 places, 9 transitions
// places: p0=p0_1, p1=p0_2, p2=p0_3, p3=p1_1, p4=p1_2, p5=p1_3, p6=p2_1, p7=p2_2, p8=p2_3

init: p0 == 1 && p1 == 1 && p2 == 1 && p3 == 100 && p4 == 100 && p5 == 100 && p6 == 1 && p7 == 1 && p8 == 1

// t0
[] p0 >= 1 && p3 >= 1 -> p0 = p0 + 1; p3 = p3 - 1; p6 = p6 + 1
// t1
[] p1 >= 1 && p4 >= 1 -> p1 = p1 + 1; p4 = p4 - 1; p7 = p7 + 1
// t2
[] p2 >= 1 && p5 >= 1 -> p2 = p2 + 1; p5 = p5 - 1; p8 = p8 + 1
// t3
[] p0 >= 3 && p6 >= 1 -> p0 = p0 - 1; p3 = p3 + 1; p6 = p6 - 1
// t4
[] p1 >= 3 && p7 >= 1 -> p1 = p1 - 1; p4 = p4 + 1; p7 = p7 - 1
// t5
[] p2 >= 3 && p8 >= 1 -> p2 = p2 - 1; p5 = p5 + 1; p8 = p8 - 1
// t6
[] p0 >= 1 && p3 >= 1 && p6 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p3 = p3 - 1; p4 = p4 + 1; p6 = p6 - 1; p7 = p7 + 1
// t7
[] p1 >= 1 && p4 >= 1 && p7 >= 1 -> p1 = p1 - 1; p2 = p2 + 1; p4 = p4 - 1; p5 = p5 + 1; p7 = p7 - 1; p8 = p8 + 1
// t8
[] p2 >= 1 && p5 >= 1 && p8 >= 1 -> p0 = p0 + 1; p2 = p2 - 1; p3 = p3 + 1; p5 = p5 - 1; p6 = p6 + 1; p8 = p8 - 1

// PGCD-PT-D02N100-LTLCardinality-13
// ap a0 := 1 <= p8
// ap a1 := 1 <= p1
// ap a2 := 3 <= p4
// spec: "((((!(a0)) U (X((!((!(a1) | a2)) | X(a0)))))) U (X(a2)))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans(q0, q1): 1 > p8
trans(q0, q2): true
trans(q0, q3): 1 <= p8
trans(q1, q4): 1 > p1 && 3 > p4 && 1 > p8
trans(q1, q5): 1 > p1 && 3 > p4 && 1 <= p8
trans!(q2, q1): 3 > p4 && 1 > p8
trans!(q2, q2): 3 > p4
trans!(q2, q3): 3 > p4 && 1 <= p8
trans(q3, q6): 1 > p1 && 3 > p4
trans!(q4, q4): 1 > p1 && 1 > p8
trans!(q4, q4): 3 <= p4 && 1 > p8
trans(q5, q6): 3 <= p4 && 1 > p8
trans(q6, q7): 1 > p8
trans!(q7, q7): true

rank(q0):
  [] p4 = 100 && p8 = 1 -> 0
  [] p4 < 100 -> inf
  [] p4 > 100 -> inf
  [] p4 = 100 && p8 < 1 -> inf
  [] p4 = 100 && p8 > 1 -> inf

rank(q1):
  [] true -> inf

rank(q2):
  [] p4 >= 99 -> 0
  [] p4 < 99 -> inf

rank(q3):
  [] p4 >= 99 -> 0
  [] p4 < 99 -> inf

rank(q4):
  [] true -> inf

rank(q5):
  [] true -> inf

rank(q6):
  [] true -> inf

rank(q7):
  [] true -> inf
