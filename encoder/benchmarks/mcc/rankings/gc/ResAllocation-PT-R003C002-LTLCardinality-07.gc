// MCC instance ResAllocation-PT-R003C002
// 12 places, 8 transitions
// places: p0=p_0_0, p1=r_0_0, p2=p_0_1, p3=r_0_1, p4=p_0_2, p5=r_0_2, p6=p_1_0, p7=r_1_0, p8=p_1_1, p9=r_1_1, p10=p_1_2, p11=r_1_2

init: p0 == 0 && p1 == 1 && p2 == 0 && p3 == 1 && p4 == 0 && p5 == 1 && p6 == 0 && p7 == 1 && p8 == 0 && p9 == 1 && p10 == 0 && p11 == 1

// t_0_0
[] p1 >= 1 -> p0 = p0 + 1; p1 = p1 - 1
// t_0_1
[] p0 >= 1 && p3 >= 1 -> p0 = p0 - 1; p1 = p1 + 1; p2 = p2 + 1; p3 = p3 - 1
// t_0_2
[] p2 >= 1 && p5 >= 1 -> p2 = p2 - 1; p3 = p3 + 1; p4 = p4 + 1; p5 = p5 - 1
// t_0_3
[] p4 >= 1 -> p4 = p4 - 1; p5 = p5 + 1
// t_1_0
[] p6 >= 1 -> p1 = p1 + 1; p6 = p6 - 1; p7 = p7 + 1
// t_1_1
[] p8 >= 1 && p1 >= 1 && p7 >= 1 -> p1 = p1 - 1; p3 = p3 + 1; p6 = p6 + 1; p7 = p7 - 1; p8 = p8 - 1; p9 = p9 + 1
// t_1_2
[] p10 >= 1 && p3 >= 1 && p9 >= 1 -> p3 = p3 - 1; p5 = p5 + 1; p8 = p8 + 1; p9 = p9 - 1; p10 = p10 - 1; p11 = p11 + 1
// t_1_3
[] p5 >= 1 && p11 >= 1 -> p5 = p5 - 1; p10 = p10 + 1; p11 = p11 - 1
// deadlock: stutter (MCC semantics)
[] p1 <= 0 && p3 <= 0 && p4 <= 0 && p5 <= 0 && p6 <= 0 -> p0 = p0

// ResAllocation-PT-R003C002-LTLCardinality-07
// ap a0 := 2 <= p8
// ap a1 := 1 <= p9
// ap a2 := p5 <= p6
// spec: "((!(G(((((X(F(a0))) U (G(a1)))) U ((a2 | G(a2))))))) U (a1))"

// Büchi automaton of !(spec) from ltl2tgba (spot) 2.16, ltl2tgba -B
automaton_init: q0
trans!(q0, q0): 1 > p9
trans!(q0, q1): 1 > p9 && p5 <= p6
trans!(q0, q2): 1 > p9 && p5 > p6
trans!(q1, q1): p5 <= p6
trans!(q1, q2): p5 > p6
trans!(q1, q3): 1 <= p9 && p5 > p6
trans(q2, q2): true
trans(q2, q3): 1 <= p9 && 2 <= p8
trans!(q3, q3): 1 <= p9 && p5 <= p6
trans!(q3, q4): 1 <= p9 && p5 > p6
trans(q4, q3): 1 <= p9 && p5 <= p6
trans(q4, q4): 1 <= p9 && p5 > p6

rank(q0):
  [] p0 = 0 && p1 = 1 && p2 = 0 && p4 = 0 && p5 = 1 && p6 = 0 && p8 = 0 && p9 = 1 -> 0
  [] p0 < 0 -> inf
  [] p0 > 0 -> inf
  [] p0 = 0 && p1 < 1 -> inf
  [] p0 = 0 && p1 > 1 -> inf
  [] p0 = 0 && p1 = 1 && p2 < 0 -> inf
  [] p0 = 0 && p1 = 1 && p2 > 0 -> inf
  [] p0 = 0 && p1 = 1 && p2 = 0 && p4 < 0 -> inf
  [] p0 = 0 && p1 = 1 && p2 = 0 && p4 > 0 -> inf
  [] p0 = 0 && p1 = 1 && p2 = 0 && p4 = 0 && p5 < 1 -> inf
  [] p0 = 0 && p1 = 1 && p2 = 0 && p4 = 0 && p5 > 1 -> inf
  [] p0 = 0 && p1 = 1 && p2 = 0 && p4 = 0 && p5 = 1 && p6 < 0 -> inf
  [] p0 = 0 && p1 = 1 && p2 = 0 && p4 = 0 && p5 = 1 && p6 > 0 -> inf
  [] p0 = 0 && p1 = 1 && p2 = 0 && p4 = 0 && p5 = 1 && p6 = 0 && p8 < 0 -> inf
  [] p0 = 0 && p1 = 1 && p2 = 0 && p4 = 0 && p5 = 1 && p6 = 0 && p8 > 0 -> inf
  [] p0 = 0 && p1 = 1 && p2 = 0 && p4 = 0 && p5 = 1 && p6 = 0 && p8 = 0 && p9 < 1 -> inf
  [] p0 = 0 && p1 = 1 && p2 = 0 && p4 = 0 && p5 = 1 && p6 = 0 && p8 = 0 && p9 > 1 -> inf

rank(q1):
  [] true -> inf

rank(q2):
  [] true -> inf

rank(q3):
  [] true -> inf

rank(q4):
  [] true -> inf
