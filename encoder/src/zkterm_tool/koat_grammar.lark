// Grammar for the KoAT / termCOMP integer-transition-system (.koat) format.
// Example:
//   (GOAL COMPLEXITY)
//   (STARTTERM (FUNCTIONSYMBOLS l0))
//   (VAR A B)
//   (RULES
//     l0(A,B) -> Com_1(l1(A,B))
//     l1(A,B) -> Com_1(l1(A - 1, B + 1)) :|: A >= 1
//   )

start: goal? startterm var_decl rules

goal: "(" "GOAL" goalbody ")"
goalbody: NAME
        | "(" NAME+ ")"

startterm: "(" "STARTTERM" "(" "FUNCTIONSYMBOLS" NAME+ ")" ")"

var_decl: "(" "VAR" NAME* ")"

rules: "(" "RULES" rule+ ")"

rule: fterm "->" rhs guardpart?
guardpart: ":|:" guard

rhs: COM "(" fterm ("," fterm)* ")"   -> rhs_com
   | fterm                            -> rhs_bare

fterm: NAME "(" arglist? ")"
arglist: expr ("," expr)*

guard: comparison (("&&" | "/\\") comparison)*
comparison: expr COMP_OP expr
COMP_OP: ">=" | "<=" | "==" | "=" | ">" | "<"

?expr: expr "+" term   -> add
     | expr "-" term   -> sub
     | term
?term: term "*" factor -> mul
     | factor
?factor: "-" factor    -> neg
       | atom
?atom: INT             -> number
     | NAME            -> var
     | "(" expr ")"

COM.2: /Com_[0-9]+/
NAME: /[A-Za-z_][A-Za-z_0-9^']*/
INT: /[0-9]+/

%import common.WS
%ignore WS
