// Grammar for guarded commands, ranking functions, initial conditions, and automaton transitions
// Example guarded command: [] y < z -> y = y + 1
// Example ranking function: rank(q0): [] x > 0 -> x
// Example initial condition: init: x = 0 && y >= 0
// Example automaton transition: trans(q0, q1): x > 0 (fair: trans!(q0, q1): x > 0)
// Example automaton initial states: automaton_init: q0, q1
// Constants: const received = 1

start: (init_condition | const_def | type_def | guarded_command | ranking_function | automaton_trans | automaton_init | ap_def | ltl_spec)*

init_condition: "init" ":" guard

// Atomic proposition binding for LTL specs: ap NAME := <conjunction of comparisons>
ap_def: "ap" VAR ":=" guard

// LTL property (proven by translating !(formula) to a Büchi automaton via Spot's ltl2tgba).
// The formula is a quoted string in Spot's LTL syntax over the declared atomic propositions.
ltl_spec: "spec" ":" ESCAPED_STRING

const_def: "const" CONST_NAME "=" const_expr

type_def: "type" VAR ":" const_expr ".." const_expr

// Constant expressions can reference other constants and use arithmetic
?const_expr: const_term
           | const_expr "+" const_term   -> const_add
           | const_expr "-" const_term   -> const_sub

?const_term: const_factor
           | const_term "*" const_factor -> const_mul

?const_factor: const_power
             | "-" const_factor          -> const_neg

?const_power: const_atom
            | const_atom "**" const_factor -> const_pow

?const_atom: NUMBER                      -> const_number
           | CONST_NAME                  -> const_name
           | "(" const_expr ")"

guarded_command: "[]" guard "->" assignments

ranking_function: "rank" "(" STATE_NAME ")" ":" ranking_case+

ranking_case: "[]" guard "->" (expr | inf_keyword)

inf_keyword: "inf"

automaton_trans: "trans" fair_mark? "(" STATE_NAME "," STATE_NAME ")" ":" guard

automaton_init: "automaton_init" ":" state_list

state_list: STATE_NAME ("," STATE_NAME)*

fair_mark: "!"

guard: "true" | comparison (("&&" | "∧") comparison)*

comparison: expr COMP_OP expr

COMP_OP: "<" | "<=" | "≤" | "=" | "==" | ">=" | "≥" | ">"

assignments: assignment (";" assignment)* ";"?

assignment: VAR "=" expr

?expr: term
     | expr "+" term   -> add
     | expr "-" term   -> sub

?term: factor
     | term "*" factor -> mul

?factor: power
       | "-" factor    -> neg

?power: atom
      | atom "**" factor -> pow

?atom: NUMBER        -> number
     | VAR           -> var
     | "(" expr ")"

CONST_NAME: /[a-zA-Z_][a-zA-Z_0-9]*/
STATE_NAME: /[a-zA-Z_][a-zA-Z_0-9]*/
VAR: /[a-zA-Z_][a-zA-Z_0-9]*/
NUMBER: /[0-9]+/

%import common.WS
%import common.ESCAPED_STRING
%ignore WS

// Single-line comments
COMMENT: "//" /[^\n]/*
%ignore COMMENT
